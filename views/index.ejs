<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* --- VARIABLES GLOBALES Y DE TEMA (FONDO NEGRO CON MORADO) --- */
        :root {
            --bg-main: #0b0416;
            --bg-gradient: radial-gradient(circle at 65% 35%, #4c1d95 0%, #1e1b4b 50%, #0b0416 85%);
            --card-bg: rgba(25, 20, 45, 0.7);
            --border-color: rgba(192, 132, 252, 0.3);
            --text-color: #ffffff;
            --text-muted: #d8b4fe;
            --accent-color: #c084fc;
            --particle-color: #ffffff;
        }

        [data-theme="light"] {
            --bg-main: #f5f3ff;
            --bg-gradient: #f8fafc;
            --card-bg: rgba(255, 255, 255, 0.9);
            --border-color: rgba(147, 51, 234, 0.2);
            --text-color: #1e1b4b;
            --text-muted: #6b21a8;
            --accent-color: #9333ea;
            --particle-color: #000000;
        }

        body {
            margin: 0;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-main);
            background-image: var(--bg-gradient);
            background-attachment: fixed;
            color: var(--text-color);
            transition: background-color 0.3s ease, background-image 0.3s ease, color 0.3s ease;
        }

        .hero {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 60px;
            padding: 30px 4%;
            min-height: 75vh;
            margin-top: 60px;
        }
        .hero-content {
            flex: 0 1 520px;
        }

        .avatar-container {
            position: relative;
            width: 360px;
            height: 360px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: floatAvatar 4s ease-in-out infinite;
        }

        @keyframes floatAvatar {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-12px); }
        }

        .spark {
            position: absolute;
            background: var(--particle-color);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--accent-color), 0 0 20px var(--accent-color);
            pointer-events: none;
            z-index: 4;
            animation: blinkSpark 2s infinite ease-in-out;
            transition: background-color 0.3s ease;
        }

        @keyframes blinkSpark {
            0%, 100% { opacity: 0.2; transform: scale(0.8); }
            50% { opacity: 1; transform: scale(1.2); }
        }

        .spark-1 { width: 6px; height: 6px; top: 15px; right: 40px; animation-delay: 0s; }
        .spark-2 { width: 8px; height: 8px; bottom: 30px; left: 15px; animation-delay: 0.5s; }
        .spark-3 { width: 5px; height: 5px; top: 50%; right: -8px; animation-delay: 1s; }
        .spark-4 { width: 7px; height: 7px; top: 10px; left: 60px; animation-delay: 1.5s; }
        .spark-5 { width: 6px; height: 6px; bottom: 15px; right: 50px; animation-delay: 0.8s; }

        @media (max-width: 900px) {
            .hero {
                flex-direction: column;
                text-align: center;
            }
        }

        .ranking-section {
            padding: 60px 4%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .podium-grid {
            display: grid;
            grid-template-columns: repeat(3, 260px);
            gap: 24px;
            max-width: 1100px;
            width: 100%;
            justify-content: center;
            align-items: start;
        }

        .glass-card {
            background: var(--card-bg);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 30px 20px;
            min-height: 380px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            transition: transform 0.3s ease, border-color 0.3s ease;
            text-align: center;
        }

        .glass-card:hover {
            border-color: var(--accent-color);
        }

        .center-card {
            transform: translateY(-15px);
            border-color: var(--accent-color);
            box-shadow: 0 12px 40px 0 rgba(192, 132, 252, 0.2);
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--accent-color);
            margin-bottom: auto;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .ranking-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
            width: 100%;
            margin: auto 0;
        }

        .empty-state {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin: auto 0;
        }

        .ranking-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid var(--border-color);
            width: 100%;
        }

        .ranking-item:last-child {
            border-bottom: none;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .ranking-pos {
            font-weight: bold;
            color: var(--accent-color);
            min-width: 20px;
        }

        .user-avatar {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 1px solid var(--accent-color);
            object-fit: cover;
        }

        .user-name {
            color: var(--text-color);
            font-size: 0.9rem;
            text-align: left;
        }

        .ranking-value {
            font-weight: bold;
            color: var(--accent-color);
            font-size: 0.9rem;
        }

        @media (max-width: 900px) {
            .podium-grid {
                grid-template-columns: 1fr;
                max-width: 320px;
            }
            .center-card {
                transform: translateY(0);
            }
        }
    </style>
</head>
<body>

    <!-- 1. Barra de navegación -->
    <%- include('partials/navbar') %>

    <!-- 2. Sección Hero -->
    <%- include('partials/hero') %>

    <!-- 3. Estadísticas Globales -->
    <%- include('partials/stats') %>

    <!-- 4. Ranking Global -->
    <%- include('partials/ranking') %>

    <!-- 5. Características Principales -->
    <%- include('partials/features') %>

    <!-- 6. Comandos Destacados -->
    <%- include('partials/commands') %>

    <!-- 7. Reseñas de la Comunidad -->
    <%- include('partials/reviews') %>

    <!-- 8. Preguntas Frecuentes -->
    <%- include('partials/faq') %>

    <!-- 9. Pie de página -->
    <%- include('partials/footer') %>

    <!-- Scripts del cliente -->
    <script src="/js/main.js"></script>
</body>
</html>