<section style="max-width: 1000px; margin: 50px auto; padding: 0 20px;">
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 style="font-size: 2rem; font-weight: 800; color: var(--text-main); margin-bottom: 10px;"><%= typeof t !== 'undefined' ? t.rankingTitle : 'Ranking Global' %></h2>
        <p style="color: var(--text-muted); font-size: 1rem;"><%= typeof t !== 'undefined' ? t.rankingDesc : 'Los usuarios más destacados de todo el ecosistema de PREM.' %></p>
    </div>

    <!-- Contenedor del podio -->
    <div class="podium-grid">
        
        <!-- 1. TOP ACTIVIDAD (XP) -->
        <div class="glass-card podium-card side-card" style="justify-content: flex-start;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 15px;">
                <i class="fa-solid fa-bolt" style="font-size: 1.3rem; color: var(--accent-color);"></i>
                <h4 style="margin: 0; font-size: 1.1rem; color: var(--text-main);"><%= typeof t !== 'undefined' ? t.topActivity : 'Top Actividad (XP)' %></h4>
            </div>
            <div style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
                <% if (typeof topActivity !== 'undefined' && topActivity && topActivity.length > 0) { %>
                    <% topActivity.forEach((user, index) => { %>
                        <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.03); padding: 10px 15px; border-radius: 12px; width: 100%; box-sizing: border-box;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span style="font-weight: bold; color: var(--text-muted); width: 20px; text-align: center;"><%= index + 1 %></span>
                                <% if (user.avatar) { %>
                                    <img src="<%= user.avatar %>" alt="<%= user.name %>" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;">
                                <% } %>
                                <span style="color: var(--text-main); font-weight: 600;"><%= user.name %></span>
                            </div>
                            <span style="font-weight: bold; color: var(--accent-color); font-size: 0.95rem;">
                                <%= user.xp || '0' %> XP
                            </span>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p style="color: var(--text-muted); text-align: center; font-size: 0.9rem; margin: 20px 0;"><%= typeof t !== 'undefined' ? t.noRecords : 'Sin registros aún' %></p>
                <% } %>
            </div>
        </div>

        <!-- 2. TOP ECONOMÍA (DINERO) -->
        <div class="glass-card podium-card center-card" style="justify-content: flex-start;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 15px;">
                <i class="fa-solid fa-wallet" style="font-size: 1.3rem; color: var(--accent-color);"></i>
                <h4 style="margin: 0; font-size: 1.1rem; color: var(--text-main);"><%= typeof t !== 'undefined' ? t.topEconomy : 'Top Economía (Dinero)' %></h4>
            </div>
            <div style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
                <% if (typeof topEconomy !== 'undefined' && topEconomy && topEconomy.length > 0) { %>
                    <% topEconomy.forEach((user, index) => { %>
                        <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.03); padding: 10px 15px; border-radius: 12px; width: 100%; box-sizing: border-box;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span style="font-weight: bold; color: var(--text-muted); width: 20px; text-align: center;"><%= index + 1 %></span>
                                <% if (user.avatar) { %>
                                    <img src="<%= user.avatar %>" alt="<%= user.name %>" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;">
                                <% } %>
                                <span style="color: var(--text-main); font-weight: 600;"><%= user.name %></span>
                            </div>
                            <span style="font-weight: bold; color: var(--accent-color); font-size: 0.95rem;">
                                $<%= formatMoney(user.money) %>
                            </span>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p style="color: var(--text-muted); text-align: center; font-size: 0.9rem; margin: 20px 0;"><%= typeof t !== 'undefined' ? t.noRecords : 'Sin registros aún' %></p>
                <% } %>
            </div>
        </div>

        <!-- 3. TOP MELÓMANOS (MÚSICA) -->
        <div class="glass-card podium-card side-card" style="justify-content: flex-start;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 15px;">
                <i class="fa-solid fa-music" style="font-size: 1.3rem; color: var(--accent-color);"></i>
                <h4 style="margin: 0; font-size: 1.1rem; color: var(--text-main);"><%= typeof t !== 'undefined' ? t.topMusic : 'Top Melómanos (Música)' %></h4>
            </div>
            <div style="display: flex; flex-direction: column; gap: 12px; width: 100%;">
                <% if (typeof topMusic !== 'undefined' && topMusic && topMusic.length > 0) { %>
                    <% topMusic.forEach((user, index) => { %>
                        <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.03); padding: 10px 15px; border-radius: 12px; width: 100%; box-sizing: border-box;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <span style="font-weight: bold; color: var(--text-muted); width: 20px; text-align: center;"><%= index + 1 %></span>
                                <% if (user.avatar) { %>
                                    <img src="<%= user.avatar %>" alt="<%= user.name %>" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;">
                                <% } %>
                                <span style="color: var(--text-main); font-weight: 600;"><%= user.name %></span>
                            </div>
                            <span style="font-weight: bold; color: var(--accent-color); font-size: 0.95rem;">
                                <%= user.songs || '0' %> min
                            </span>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p style="color: var(--text-muted); text-align: center; font-size: 0.9rem; margin: 20px 0;"><%= typeof t !== 'undefined' ? t.noRecords : 'Sin registros aún' %></p>
                <% } %>
            </div>
        </div>

    </div>
</section>