<footer style="border-top: 1px solid var(--border-color); padding: 40px 20px; margin-top: 80px; text-align: center; background: var(--card-bg); backdrop-filter: blur(15px);">
    <div style="max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; gap: 20px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <img src="<%= typeof botAvatarUrl !== 'undefined' ? botAvatarUrl : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="PREM Avatar" style="width: 28px; height: 28px; border-radius: 50%;">
            <span style="font-weight: 700; color: var(--text-main); font-size: 1.1rem;">PREM</span>
        </div>

        <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">
            &copy; 2026 PREM Bot. <%= typeof t !== 'undefined' ? t.footerRights : 'Todos los derechos reservados. No afiliado con Discord Inc.' %>
        </p>

        <div style="display: flex; gap: 20px; flex-wrap: wrap; justify-content: center;">
            <a href="/support" style="color: var(--text-muted); text-decoration: none; font-size: 0.9kt; transition: color 0.2s;"><%= typeof t !== 'undefined' ? t.footerSupport : 'Soporte' %></a>
            <a href="/terms" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem; transition: color 0.2s;"><%= typeof t !== 'undefined' ? t.footerTerms : 'Términos de Servicio' %></a>
            <a href="/privacy" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem; transition: color 0.2s;"><%= typeof t !== 'undefined' ? t.footerPrivacy : 'Política de Privacidad' %></a>
        </div>
    </div>
</footer>