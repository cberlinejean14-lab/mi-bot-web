<header>
    <div class="nav-left">
        <a href="/" class="brand-link">
            <div style="position: relative; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <div style="position: absolute; width: 100%; height: 100%; border-radius: 50%; border: 2px solid var(--accent-color); box-shadow: 0 0 12px var(--accent-glow), inset 0 0 8px var(--accent-glow); pointer-events: none;"></div>
                <img src="https://cdn.discordapp.com/avatars/1534632950224781548/a_678d6b7de1507542e3636f611d297e20.gif?size=2048" alt="PREM" class="bot-avatar" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; position: relative; z-index: 1; border: none; box-shadow: none;">
            </div>
            <span class="bot-name">PREM</span>
        </a>

        <!-- Menú de Navegación limpio que usa el CSS global -->
        <nav>
            <div class="dropdown-container" style="position: relative; display: inline-block;">
                <button onclick="toggleDropdown('recursosDropdown')" class="login-btn" style="padding: 7px 14px; border-radius: 8px; cursor: pointer;">
                    Recursos <i class="fa-solid fa-chevron-down" style="font-size: 10px; color: var(--text-muted);"></i>
                </button>
                <div id="recursosDropdown" style="display: none; position: absolute; left: 0; top: 45px; width: 180px; background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 12px; box-shadow: 0 15px 35px rgba(0,0,0,0.7); padding: 8px; z-index: 1000;">
                    <a href="/comandos" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-terminal" style="color: #a855f7;"></i> Comandos</a>
                    <a href="/variables" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-code" style="color: #a855f7;"></i> Variables</a>
                    <a href="/documentacion" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-book" style="color: #a855f7;"></i> Documentación</a>
                </div>
            </div>

            <div class="dropdown-container" style="position: relative; display: inline-block;">
                <button onclick="toggleDropdown('soporteDropdown')" class="login-btn" style="padding: 7px 14px; border-radius: 8px; cursor: pointer;">
                    Soporte <i class="fa-solid fa-chevron-down" style="font-size: 10px; color: var(--text-muted);"></i>
                </button>
                <div id="soporteDropdown" style="display: none; position: absolute; left: 0; top: 45px; width: 220px; background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 12px; box-shadow: 0 15px 35px rgba(0,0,0,0.7); padding: 8px; z-index: 1000;">
                    <a href="/#faq-section" onclick="toggleDropdown('soporteDropdown')" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-circle-question" style="color: #a855f7;"></i> Preguntas Frecuentes</a>
                    <a href="https://discord.gg/tu-servidor" target="_blank" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-brands fa-discord" style="color: #5865F2;"></i> Servidor de Soporte</a>
                    <a href="/contacto" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-envelope" style="color: #a855f7;"></i> Contáctanos</a>
                    <a href="/quejas" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-triangle-exclamation" style="color: #ef4444;"></i> Quejas</a>
                    <a href="/sugerencias" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-lightbulb" style="color: #fbbf24;"></i> Sugerencias</a>
                </div>
            </div>
        </nav>
    </div>

    <div class="nav-right" style="display: flex; align-items: center; gap: 15px;">
        <!-- Selector de Idiomas -->
        <div style="position: relative; display: inline-block;">
            <button onclick="toggleDropdown('customLangMenu')" class="login-btn" style="padding: 7px 14px; border-radius: 10px; cursor: pointer;">
                <% 
                    let currentFlagCode = 'es'; 
                    let currentName = 'Español';
                    const langCode = typeof currentLang !== 'undefined' ? currentLang : (typeof lang !== 'undefined' ? lang : 'es');
                    if (langCode === 'en') { currentFlagCode = 'us'; currentName = 'English'; }
                    else if (langCode === 'pt') { currentFlagCode = 'br'; currentName = 'Português'; }
                    else if (langCode === 'fr') { currentFlagCode = 'fr'; currentName = 'Français'; }
                    else if (langCode === 'hi') { currentFlagCode = 'in'; currentName = 'हिन्दी'; }
                    else if (langCode === 'ar') { currentFlagCode = 'sa'; currentName = 'العربية'; }
                    else if (langCode === 'zh') { currentFlagCode = 'cn'; currentName = '中文'; }
                %>
                <img src="https://flagcdn.com/w20/<%= currentFlagCode %>.png" alt="flag" style="width: 18px; height: 13px; border-radius: 2px; object-fit: cover;">
                <span><%= currentName %></span>
                <i class="fa-solid fa-chevron-down" style="font-size: 10px; color: var(--text-muted); margin-left: 2px;"></i>
            </button>

            <div id="customLangMenu" style="display: none; position: absolute; right: 0; top: 48px; width: 170px; background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 12px; box-shadow: 0 15px 35px rgba(0,0,0,0.8); padding: 6px; z-index: 10000; backdrop-filter: blur(20px);">
                <a href="?lang=es" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/es.png" style="width: 18px; height: 13px; border-radius: 2px;"> Español</a>
                <a href="?lang=en" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/us.png" style="width: 18px; height: 13px; border-radius: 2px;"> English</a>
                <a href="?lang=pt" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/br.png" style="width: 18px; height: 13px; border-radius: 2px;"> Português</a>
                <a href="?lang=fr" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/fr.png" style="width: 18px; height: 13px; border-radius: 2px;"> Français</a>
                <a href="?lang=hi" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/in.png" style="width: 18px; height: 13px; border-radius: 2px;"> हिन्दी</a>
                <a href="?lang=ar" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/sa.png" style="width: 18px; height: 13px; border-radius: 2px;"> العربية</a>
                <a href="?lang=zh" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/cn.png" style="width: 18px; height: 13px; border-radius: 2px;"> 中文</a>
            </div>
        </div>

        <!-- Botón de Tema -->
        <button class="theme-btn" id="themeToggleBtn" onclick="toggleTheme()" title="Cambiar tema">
            <i class="fa-solid fa-moon" id="themeIcon"></i>
        </button>

        <!-- Usuario / Login -->
        <% if (typeof user !== 'undefined' && user) { %>
            <div style="position: relative; display: inline-block;">
                <div onclick="toggleDropdown('userDropdownMenu')" class="user-profile">
                    <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="Avatar" class="user-avatar">
                    <span style="font-size: 13px; font-weight: 600; color: var(--text-main);"><%= user.username %></span>
                    <i class="fa-solid fa-chevron-down" style="font-size: 10px; color: var(--text-muted);"></i>
                </div>

                <div id="userDropdownMenu" style="display: none; position: absolute; right: 0; top: 52px; width: 250px; max-height: 450px; overflow-y: auto; background: var(--bg-sidebar); border: 1px solid var(--border-color); border-radius: 14px; box-shadow: 0 15px 35px rgba(0,0,0,0.7); padding: 12px; z-index: 1000;">
                    <div style="padding: 6px 10px 10px 10px; border-bottom: 1px solid var(--border-color); margin-bottom: 8px;">
                        <div style="font-size: 14px; font-weight: 700; color: var(--text-main);"><%= user.username %></div>
                        <div style="font-size: 11px; color: var(--text-muted);">@<%= user.username.toLowerCase() %></div>
                    </div>

                    <a href="/dashboard" style="display: flex; align-items: center; gap: 10px; padding: 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 600; border-radius: 8px;">
                        <i class="fa-solid fa-server" style="color: #a855f7;"></i> Mis servidores
                    </a>
                    <a href="#" onclick="toggleTheme(); toggleDropdown('userDropdownMenu'); return false;" style="display: flex; align-items: center; gap: 10px; padding: 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 600; border-radius: 8px;">
                        <i class="fa-solid fa-moon" style="color: #a855f7;"></i> Preferencias / Tema
                    </a>

                    <div style="font-size: 10px; color: var(--text-muted); font-weight: bold; text-transform: uppercase; padding: 10px 10px 4px 10px;">Gestión de PREM Bot</div>
                    <a href="/dashboard/custom-bot" style="display: flex; align-items: center; gap: 10px; padding: 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 600; border-radius: 8px;">
                        <i class="fa-solid fa-robot" style="color: #a855f7;"></i> Personalización de Bot
                    </a>
                    <a href="/dashboard/custom-commands" style="display: flex; align-items: center; justify-content: space-between; padding: 10px; color: var(--text-main); text-decoration: none; font-size: 13px; font-weight: 600; border-radius: 8px;">
                        <div style="display: flex; align-items: center; gap: 10px;"><i class="fa-solid fa-code" style="color: #a855f7;"></i> Comandos personalizados</div>
                        <span style="background: linear-gradient(135deg, #fbbf24, #d97706); color: #000; font-size: 9px; font-weight: 800; padding: 2px 6px; border-radius: 4px;">PREMIUM</span>
                    </a>

                    <div style="border-top: 1px solid var(--border-color); margin-top: 8px; padding-top: 8px;">
                        <a href="/auth/logout" style="display: flex; align-items: center; gap: 10px; padding: 10px; color: #ef4444; text-decoration: none; font-size: 13px; font-weight: 600; border-radius: 8px;">
                            <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
                        </a>
                    </div>
                </div>
            </div>
        <% } else { %>
            <a href="/auth/discord" class="login-btn">
                <i class="fa-brands fa-discord"></i> Iniciar Sesión
            </a>
        <% } %>
    </div>
</header>

<script>
    window.toggleDropdown = function(id) {
        event.stopPropagation();
        const dropdowns = ['recursosDropdown', 'soporteDropdown', 'userDropdownMenu', 'customLangMenu'];
        dropdowns.forEach(d => {
            const el = document.getElementById(d);
            if (el && d !== id) el.style.display = 'none';
        });
        const target = document.getElementById(id);
        if (target) {
            target.style.display = target.style.display === 'block' ? 'none' : 'block';
        }
    };

    window.addEventListener('click', () => {
        ['recursosDropdown', 'soporteDropdown', 'userDropdownMenu', 'customLangMenu'].forEach(d => {
            const el = document.getElementById(d);
            if (el) el.style.display = 'none';
        });
    });

    window.toggleTheme = function() {
        const htmlEl = document.documentElement;
        const currentTheme = htmlEl.getAttribute('data-theme');
        const themeIcon = document.getElementById('themeIcon');
        
        if (currentTheme === 'light') {
            htmlEl.setAttribute('data-theme', 'dark');
            if (themeIcon) {
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            }
            localStorage.setItem('theme', 'dark');
        } else {
            htmlEl.setAttribute('data-theme', 'light');
            if (themeIcon) {
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            }
            localStorage.setItem('theme', 'light');
        }
    };

    document.addEventListener('DOMContentLoaded', () => {
        const savedTheme = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
        const themeIcon = document.getElementById('themeIcon');
        if (themeIcon) {
            if (savedTheme === 'light') {
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            } else {
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            }
        }
    });
</script>