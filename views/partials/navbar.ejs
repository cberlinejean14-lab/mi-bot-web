<header style="position: fixed; top: 0; left: 0; right: 0; height: 70px; background-color: var(--nav-bg, #12101f); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.1)); display: flex; justify-content: space-between; align-items: center; padding: 0 40px; z-index: 99999; box-sizing: border-box;">
        
    <div class="nav-left" style="display: flex; align-items: center; gap: 25px;">
        <a href="/" class="brand-link" style="display: flex; align-items: center; gap: 12px; text-decoration: none;">
            <!-- Contenedor del avatar con resplandor -->
            <div style="position: relative; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <div style="position: absolute; width: 100%; height: 100%; border-radius: 50%; border: 2px solid var(--accent-color, #c084fc); box-shadow: 0 0 12px var(--accent-glow, rgba(192, 132, 252, 0.8)); pointer-events: none;"></div>
                <img src="https://cdn.discordapp.com/avatars/1534632950224781548/a_678d6b7de1507542e3636f611d297e20.gif?size=2048" alt="PREM" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; position: relative; z-index: 1;">
            </div>
            <span class="bot-name" style="font-weight: 700; font-size: 1.25rem; color: var(--text-main, #e9d5ff);">PREM</span>
        </a>

        <!-- Menú de Navegación -->
        <nav style="display: flex; align-items: center; gap: 10px; background: transparent !important; border: none !important; padding: 0 !important;">
            <!-- Dropdown Recursos -->
            <div style="position: relative; display: inline-block;">
                <button onclick="toggleDropdown('recursosDropdown')" style="background: transparent; border: 1px solid transparent; color: var(--text-main, #fff); font-size: 14px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 8px; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='transparent'">
                    Recursos <i class="fa-solid fa-chevron-down" style="font-size: 10px; color: var(--text-muted, #9ca3af);"></i>
                </button>
                <div id="recursosDropdown" style="display: none; position: absolute; left: 0; top: 45px; width: 180px; background: var(--bg-sidebar, #12101f); border: 1px solid var(--border-color, rgba(255,255,255,0.1)); border-radius: 12px; box-shadow: 0 15px 35px rgba(0,0,0,0.7); padding: 8px; z-index: 1000;">
                    <a href="/comandos" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-terminal" style="color: #a855f7;"></i> Comandos</a>
                    <a href="/variables" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-code" style="color: #a855f7;"></i> Variables</a>
                    <a href="/documentacion" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-book" style="color: #a855f7;"></i> Documentación</a>
                </div>
            </div>

            <!-- Dropdown Soporte -->
            <div style="position: relative; display: inline-block;">
                <button onclick="toggleDropdown('soporteDropdown')" style="background: transparent; border: 1px solid transparent; color: var(--text-main, #fff); font-size: 14px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; padding: 7px 14px; border-radius: 8px; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='transparent'">
                    Soporte <i class="fa-solid fa-chevron-down" style="font-size: 10px; color: var(--text-muted, #9ca3af);"></i>
                </button>
                <div id="soporteDropdown" style="display: none; position: absolute; left: 0; top: 45px; width: 220px; background: var(--bg-sidebar, #12101f); border: 1px solid var(--border-color, rgba(255,255,255,0.1)); border-radius: 12px; box-shadow: 0 15px 35px rgba(0,0,0,0.7); padding: 8px; z-index: 1000;">
                    <a href="/#faq-section" onclick="toggleDropdown('soporteDropdown')" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-circle-question" style="color: #a855f7;"></i> Preguntas Frecuentes</a>
                    <a href="https://discord.gg/tu-servidor" target="_blank" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-brands fa-discord" style="color: #5865F2;"></i> Servidor de Soporte</a>
                    <a href="/contacto" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-envelope" style="color: #a855f7;"></i> Contáctanos</a>
                    <a href="/quejas" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-triangle-exclamation" style="color: #ef4444;"></i> Quejas</a>
                    <a href="/sugerencias" style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><i class="fa-solid fa-lightbulb" style="color: #fbbf24;"></i> Sugerencias</a>
                </div>
            </div>
        </nav>
    </div>

    <div class="nav-right" style="display: flex; align-items: center; gap: 15px;">
        
        <!-- Selector de Idiomas -->
        <div style="position: relative; display: inline-block;">
            <button onclick="toggleDropdown('customLangMenu')" style="background: var(--card-bg, rgba(20, 18, 35, 0.65)); border: 1px solid var(--border-color, rgba(255,255,255,0.1)); color: var(--text-main, #fff); padding: 7px 14px; border-radius: 10px; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                <% 
                    let currentFlagCode = 'es'; 
                    let currentName = 'Español';
                    const langCode = typeof currentLang !== 'undefined' ? currentLang : (typeof lang !== 'undefined' ? lang : 'es');
                    if (langCode === 'en') { currentFlagCode = 'us'; currentName = 'English'; }
                    else if (langCode === 'pt') { currentFlagCode = 'br'; currentName = 'Português'; }
                    else if (langCode === 'fr') { currentFlagCode = 'fr'; currentName = 'Français'; }
                    else if (langCode === 'hi') { currentFlagCode = 'in'; currentName = 'हिन्दी'; }
                    else if (langCode === 'ar') { currentFlagCode = 'sa'; currentName = 'العربية'; }
                    else if (langCode === 'zh') { currentFlagCode = 'cn'; currentName = '中文'; }
                %>
                <img src="https://flagcdn.com/w20/<%= currentFlagCode %>.png" alt="flag" style="width: 18px; height: 13px; border-radius: 2px; object-fit: cover;">
                <span><%= currentName %></span>
                <i class="fa-solid fa-chevron-down" style="font-size: 10px; color: var(--text-muted, #9ca3af);"></i>
            </button>

            <div id="customLangMenu" style="display: none; position: absolute; right: 0; top: 48px; width: 170px; background: var(--bg-sidebar, #12101f); border: 1px solid var(--border-color, rgba(255,255,255,0.1)); border-radius: 12px; box-shadow: 0 15px 35px rgba(0,0,0,0.8); padding: 6px; z-index: 10000; backdrop-filter: blur(20px);">
                <a href="?lang=es" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/es.png" style="width: 18px; height: 13px; border-radius: 2px;"> Español</a>
                <a href="?lang=en" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/us.png" style="width: 18px; height: 13px; border-radius: 2px;"> English</a>
                <a href="?lang=pt" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/br.png" style="width: 18px; height: 13px; border-radius: 2px;"> Português</a>
                <a href="?lang=fr" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/fr.png" style="width: 18px; height: 13px; border-radius: 2px;"> Français</a>
                <a href="?lang=hi" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/in.png" style="width: 18px; height: 13px; border-radius: 2px;"> हिन्दी</a>
                <a href="?lang=ar" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/sa.png" style="width: 18px; height: 13px; border-radius: 2px;"> العربية</a>
                <a href="?lang=zh" style="display: flex; align-items: center; gap: 10px; padding: 8px 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 500; border-radius: 6px;"><img src="https://flagcdn.com/w20/cn.png" style="width: 18px; height: 13px; border-radius: 2px;"> 中文</a>
            </div>
        </div>

        <!-- Botón Tema -->
        <button id="themeToggleBtn" onclick="toggleTheme()" title="Cambiar tema" style="background: var(--card-bg, rgba(20, 18, 35, 0.65)); border: 1px solid var(--border-color, rgba(255,255,255,0.1)); color: var(--text-main, #fff); width: 38px; height: 38px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 15px;">
            <i class="fa-solid fa-moon" id="themeIcon"></i>
        </button>

        <!-- Usuario / Iniciar Sesión -->
        <% if (typeof user !== 'undefined' && user) { %>
            <div style="position: relative; display: inline-block;">
                <div onclick="toggleDropdown('userDropdownMenu')" style="display: flex; align-items: center; gap: 10px; background: var(--card-bg, rgba(20, 18, 35, 0.65)); border: 1px solid var(--border-color, rgba(255,255,255,0.1)); padding: 6px 14px; border-radius: 30px; cursor: pointer;">
                    <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="Avatar" style="width: 28px; height: 28px; border-radius: 50%;">
                    <span style="font-size: 13px; font-weight: 600; color: var(--text-main, #fff);"><%= user.username %></span>
                    <i class="fa-solid fa-chevron-down" style="font-size: 10px; color: var(--text-muted, #9ca3af);"></i>
                </div>

                <div id="userDropdownMenu" style="display: none; position: absolute; right: 0; top: 52px; width: 250px; max-height: 450px; overflow-y: auto; background: var(--bg-sidebar, #12101f); border: 1px solid var(--border-color, rgba(255,255,255,0.1)); border-radius: 14px; box-shadow: 0 15px 35px rgba(0,0,0,0.7); padding: 12px; z-index: 1000;">
                    <div style="padding: 6px 10px 10px 10px; border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.1)); margin-bottom: 8px;">
                        <div style="font-size: 14px; font-weight: 700; color: var(--text-main, #fff);"><%= user.username %></div>
                        <div style="font-size: 11px; color: var(--text-muted, #9ca3af);">@<%= user.username.toLowerCase() %></div>
                    </div>
                    <a href="/dashboard" style="display: flex; align-items: center; gap: 10px; padding: 10px; color: var(--text-main, #fff); text-decoration: none; font-size: 13px; font-weight: 600; border-radius: 8px;">
                        <i class="fa-solid fa-server" style="color: #a855f7;"></i> Mis servidores
                    </a>
                    <a href="/auth/logout" style="display: flex; align-items: center; gap: 10px; padding: 10px; color: #ef4444; text-decoration: none; font-size: 13px; font-weight: 600; border-radius: 8px; margin-top: 8px; border-top: 1px solid var(--border-color, rgba(255,255,255,0.1));">
                        <i class="fa-solid fa-right-from-bracket"></i> Cerrar sesión
                    </a>
                </div>
            </div>
        <% } else { %>
            <a href="/auth/discord" style="background: var(--card-bg, rgba(20, 18, 35, 0.65)); color: var(--text-main, #fff); padding: 8px 16px; border-radius: 8px; text-decoration: none; font-weight: 600; border: 1px solid var(--border-color, rgba(255,255,255,0.1)); display: flex; align-items: center; gap: 8px;">
                <i class="fa-brands fa-discord"></i> Iniciar Sesión
            </a>
        <% } %>
    </div>
</header>

<script>
    window.toggleDropdown = function(id) {
        event.stopPropagation();
        const dropdowns = ['recursosDropdown', 'soporteDropdown', 'userDropdownMenu', 'customLangMenu'];
        dropdowns.forEach(d => {
            const el = document.getElementById(d);
            if (el && d !== id) el.style.display = 'none';
        });
        const target = document.getElementById(id);
        if (target) {
            target.style.display = target.style.display === 'block' ? 'none' : 'block';
        }
    };

    window.addEventListener('click', () => {
        ['recursosDropdown', 'soporteDropdown', 'userDropdownMenu', 'customLangMenu'].forEach(d => {
            const el = document.getElementById(d);
            if (el) el.style.display = 'none';
        });
    });

    window.toggleTheme = function() {
        const htmlEl = document.documentElement;
        const currentTheme = htmlEl.getAttribute('data-theme');
        const themeIcon = document.getElementById('themeIcon');
        
        if (currentTheme === 'light') {
            htmlEl.setAttribute('data-theme', 'dark');
            if (themeIcon) { themeIcon.classList.remove('fa-sun'); themeIcon.classList.add('fa-moon'); }
            localStorage.setItem('theme', 'dark');
        } else {
            htmlEl.setAttribute('data-theme', 'light');
            if (themeIcon) { themeIcon.classList.remove('fa-moon'); themeIcon.classList.add('fa-sun'); }
            localStorage.setItem('theme', 'light');
        }
    };

    document.addEventListener('DOMContentLoaded', () => {
        const savedTheme = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
        const themeIcon = document.getElementById('themeIcon');
        if (themeIcon) {
            if (savedTheme === 'light') {
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            } else {
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            }
        }
    });
</script>