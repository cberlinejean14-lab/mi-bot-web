<section class="hero" style="display: flex; align-items: center; justify-content: center; gap: 60px; padding: 30px 4%; min-height: 75vh; margin-top: 60px;">
    <div class="hero-content" style="flex: 0 1 520px;">
        <div class="badge-container" style="display: flex; gap: 10px; margin-bottom: 15px;">
            <div class="badge" style="background: rgba(168, 85, 247, 0.15); padding: 5px 12px; border-radius: 20px; border: 1px solid rgba(168, 85, 247, 0.3); font-size: 0.8rem; color: #c084fc;">
                <i class="fa-solid fa-wand-magic-sparkles"></i> <%= typeof t !== 'undefined' && t.heroBadge ? t.heroBadge : 'The new evolution for servers' %>
            </div>
            <div class="prem-original-badge" style="background: rgba(168, 85, 247, 0.15); padding: 5px 12px; border-radius: 20px; border: 1px solid rgba(168, 85, 247, 0.3); font-size: 0.8rem; color: #c084fc;">
                <i class="fa-solid fa-award"></i> <%= typeof t !== 'undefined' && t.heroBadgeOriginal ? t.heroBadgeOriginal : 'PREM Original' %>
            </div>
        </div>

        <h1 style="font-size: 2.6rem; font-weight: 800; line-height: 1.1; margin-bottom: 15px;"><%= typeof t !== 'undefined' && t.heroTitle ? t.heroTitle : 'The ultimate ecosystem for creators and communities' %></h1>
        
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 25px;">
            <%= typeof t !== 'undefined' && t.heroDesc ? t.heroDesc : "Reinvent your users' interaction with advanced leveling systems, automated management, and high-fidelity audio playback." %>
        </p>

        <div class="hero-buttons" style="display: flex; gap: 15px;">
            <a href="https://discord.com/oauth2/authorize?client_id=1534632950224781548&scope=bot&permissions=8" target="_blank" class="btn-primary" style="background: #a855f7; color: white; padding: 10px 22px; border-radius: 12px; text-decoration: none; font-weight: 600; box-shadow: 0 4px 15px rgba(168, 85, 247, 0.4);">
                <i class="fa-solid fa-plus"></i> <%= typeof t !== 'undefined' && t.heroAdd ? t.heroAdd : 'Add to Discord' %>
            </a>
            <a href="/dashboard" class="btn-secondary" style="background: rgba(255,255,255,0.05); color: white; padding: 10px 22px; border-radius: 12px; text-decoration: none; font-weight: 600; border: 1px solid rgba(255,255,255,0.1);">
                <i class="fa-solid fa-server"></i> <%= typeof t !== 'undefined' && t.heroManage ? t.heroManage : 'Manage servers' %>
            </a>
        </div>
    </div>

    <!-- Contenedor del perfil grande flotante -->
    <div class="avatar-container" style="position: relative; width: 360px; height: 360px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; animation: floatAvatar 4s ease-in-out infinite;">
        <!-- Círculo brillante intensificado -->
        <div class="circle-glow" style="position: absolute; width: 100%; height: 100%; border-radius: 50%; border: 3px solid #c084fc; box-shadow: 0 0 70px rgba(192, 132, 252, 0.7), 0 0 25px rgba(192, 132, 252, 0.5), inset 0 0 40px rgba(192, 132, 252, 0.4); pointer-events: none; z-index: 3;"></div>
        
        <!-- Imagen de perfil -->
        <img src="https://cdn.discordapp.com/avatars/1534632950224781548/a_678d6b7de1507542e3636f611d297e20.gif?size=2048" alt="PREM Character" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; position: relative; z-index: 2;">

        <div class="spark spark-1" style="position: absolute; background: #ffffff; border-radius: 50%; box-shadow: 0 0 10px #a855f7, 0 0 20px #a855f7; pointer-events: none; z-index: 4; animation: blinkSpark 2s infinite ease-in-out; width: 6px; height: 6px; top: 15px; right: 40px; animation-delay: 0s;"></div>
        <div class="spark spark-2" style="position: absolute; background: #ffffff; border-radius: 50%; box-shadow: 0 0 10px #a855f7, 0 0 20px #a855f7; pointer-events: none; z-index: 4; animation: blinkSpark 2s infinite ease-in-out; width: 8px; height: 8px; bottom: 30px; left: 15px; animation-delay: 0.5s;"></div>
        <div class="spark spark-3" style="position: absolute; background: #ffffff; border-radius: 50%; box-shadow: 0 0 10px #a855f7, 0 0 20px #a855f7; pointer-events: none; z-index: 4; animation: blinkSpark 2s infinite ease-in-out; width: 5px; height: 5px; top: 50%; right: -8px; animation-delay: 1s;"></div>
        <div class="spark spark-4" style="position: absolute; background: #ffffff; border-radius: 50%; box-shadow: 0 0 10px #a855f7, 0 0 20px #a855f7; pointer-events: none; z-index: 4; animation: blinkSpark 2s infinite ease-in-out; width: 7px; height: 7px; top: 10px; left: 60px; animation-delay: 1.5s;"></div>
        <div class="spark spark-5" style="position: absolute; background: #ffffff; border-radius: 50%; box-shadow: 0 0 10px #a855f7, 0 0 20px #a855f7; pointer-events: none; z-index: 4; animation: blinkSpark 2s infinite ease-in-out; width: 6px; height: 6px; bottom: 15px; right: 50px; animation-delay: 0.8s;"></div>
    </div>
</section>