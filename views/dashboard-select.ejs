<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>PREM - Select Server</title>
    <style>
        :root {
            --bg-main: #0b0914;
            --nav-bg: rgba(18, 15, 31, 0.75);
            --card-bg: rgba(26, 21, 45, 0.6);
            --border-color: rgba(139, 92, 246, 0.2);
            --text-color: #ffffff;
            --text-muted: #9ca3af;
            --accent-color: #a855f7;
            --accent-glow: rgba(168, 85, 247, 0.4);
        }

        [data-theme="light"] {
            --bg-main: #f3f4f6;
            --nav-bg: rgba(255, 255, 255, 0.85);
            --card-bg: rgba(255, 255, 255, 0.9);
            --border-color: rgba(0, 0, 0, 0.1);
            --text-color: #1f2937;
            --text-muted: #374151;
            --accent-color: #9333ea;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-color);
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 40px;
            background: var(--nav-bg);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
            color: var(--text-color);
        }

        .bot-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--accent-color);
            box-shadow: 0 0 15px var(--accent-glow);
        }

        .bot-name {
            font-weight: 800;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
        }

        /* ===== CONTENEDOR PRINCIPAL CON PADDING-TOP ROBUSTO ===== */
        .container {
            max-width: 1200px;
            margin: 0 auto 40px auto;
            padding: 140px 20px 40px 20px;
            flex: 1;
            width: 100%;
            box-sizing: border-box;
            position: relative;
            z-index: 1;
        }

        h1 {
            font-size: 2.2rem;
            font-weight: 800;
            margin-bottom: 8px;
            color: var(--text-color);
        }

        .subtitle {
            color: var(--text-muted);
            font-size: 1rem;
            margin-bottom: 30px;
        }

        .search-container {
            margin-bottom: 30px;
        }

        .search-input {
            width: 100%;
            max-width: 450px;
            padding: 12px 20px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            color: var(--text-color);
            font-size: 0.95rem;
            outline: none;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

        .search-input:focus {
            border-color: var(--accent-color);
            box-shadow: 0 0 15px var(--accent-glow);
        }

        .guilds-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
        }

        .guild-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 20px;
            backdrop-filter: blur(10px);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            box-sizing: border-box;
            max-width: 100%;
        }

        .guild-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 25px rgba(168, 85, 247, 0.15);
            border-color: var(--accent-color);
        }

        .guild-info {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .guild-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
            background: rgba(168, 85, 247, 0.1);
            border: 2px solid var(--border-color);
            flex-shrink: 0;
        }

        .guild-details h3 {
            margin: 0 0 4px 0;
            font-size: 1.05rem;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 170px;
        }

        .guild-role {
            font-size: 0.8rem;
            color: var(--text-muted);
            background: rgba(255, 255, 255, 0.05);
            padding: 2px 8px;
            border-radius: 6px;
            display: inline-block;
        }

        .btn-manage {
            display: block;
            text-align: center;
            background: var(--accent-color);
            color: white;
            text-decoration: none;
            padding: 10px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: opacity 0.2s ease, box-shadow 0.2s ease;
            box-shadow: 0 4px 12px var(--accent-glow);
            box-sizing: border-box;
            max-width: 100%;
        }

        .btn-manage:hover {
            opacity: 0.9;
            box-shadow: 0 6px 16px var(--accent-glow);
        }

        .btn-invite {
            display: block;
            text-align: center;
            background: linear-gradient(135deg, #a855f7, #c084fc);
            color: white;
            text-decoration: none;
            padding: 10px;
            border-radius: 10px;
            font-weight: 700;
            font-size: 0.9rem;
            transition: all 0.2s ease;
            box-shadow: 0 4px 15px rgba(168, 85, 247, 0.4);
            border: 1px solid rgba(192, 132, 252, 0.5);
            box-sizing: border-box;
            max-width: 100%;
        }

        .btn-invite:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(168, 85, 247, 0.5);
        }

        .theme-btn {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            color: var(--text-color);
            width: 38px;
            height: 38px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .theme-btn:hover {
            border-color: var(--accent-color);
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: 5px 12px 5px 6px;
            border-radius: 30px;
            cursor: pointer;
        }

        .user-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
        }

        footer {
            text-align: center;
            padding: 20px;
            color: var(--text-muted);
            font-size: 0.85rem;
            border-top: 1px solid var(--border-color);
            margin-top: 40px;
        }
    </style>
</head>
<body>

    <%- include('partials/navbar') %>

    <div class="container">
        <h1><%= typeof t !== 'undefined' && t.dashSelectTitle ? t.dashSelectTitle : 'Selecciona un servidor' %></h1>
        <p class="subtitle"><%= typeof t !== 'undefined' && t.dashSelectSubtitle ? t.dashSelectSubtitle : 'Elige un servidor donde tienes permisos de administrador para gestionar el bot.' %></p>

        <div class="search-container">
            <input type="text" id="serverSearch" class="search-input" placeholder="<%= typeof t !== 'undefined' && t.dashSelectSearch ? t.dashSelectSearch : 'Buscar servidores por nombre...' %>">
        </div>

        <div class="guilds-grid" id="guildsGrid">
            <% if (typeof guilds !== 'undefined' && Array.isArray(guilds)) { %>
                <% guilds.forEach(guild => { %>
                    <% if (guild && guild.name) { %>
                        <% 
                            const esAdmin = guild.permissions ? (guild.permissions & 0x8) === 0x8 : guild.administrator; 
                            const esOwner = guild.owner;
                            // Solo mostrar servidores donde el usuario es admin o owner
                            if (esAdmin || esOwner) {
                                // Verificar si el bot está en el servidor usando la lógica real
                                const botInServer = typeof guild.botInGuild !== 'undefined' ? guild.botInGuild : false;
                        %>
                        <div class="guild-card" data-name="<%= guild.name.toLowerCase() %>">
                            <div class="guild-info">
                                <% if (guild.icon) { %>
                                    <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="Icon" class="guild-icon">
                                <% } else { %>
                                    <div class="guild-icon" style="display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.2rem; color: var(--accent-color);">
                                        <%= guild.name.charAt(0) %>
                                    </div>
                                <% } %>
                                <div class="guild-details">
                                    <h3 title="<%= guild.name %>"><%= guild.name %></h3>
                                    <span class="guild-role">
                                        <%= guild.owner 
                                            ? (typeof t !== 'undefined' && t.dashOwner ? t.dashOwner : 'Propietario') 
                                            : (typeof t !== 'undefined' && t.dashAdmin ? t.dashAdmin : 'Administrador') 
                                        %>
                                    </span>
                                </div>
                            </div>
                            
                            <% if (botInServer) { %>
                                <a href="/dashboard/<%= guild.id %>?lang=<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" class="btn-manage"><%= typeof t !== 'undefined' && t.dashManage ? t.dashManage : 'Gestionar' %></a>
                            <% } else { %>
                                <a href="https://discord.com/oauth2/authorize?client_id=1534632950224781548&scope=bot&permissions=8&guild_id=<%= guild.id %>" target="_blank" class="btn-invite">
                                    <i class="fa-solid fa-plus"></i> <%= typeof t !== 'undefined' && t.dashInvite ? t.dashInvite : 'Invitar' %>
                                </a>
                            <% } %>
                        </div>
                        <% } %>
                    <% } %>
                <% }) %>
            <% } %>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 PREM Bot. <%= typeof t !== 'undefined' && t.dashFooterRights ? t.dashFooterRights : 'Todos los derechos reservados.' %></p>
    </footer>

    <script>
        const searchInput = document.getElementById('serverSearch');
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase();
                const cards = document.querySelectorAll('.guild-card');
                cards.forEach(card => {
                    const name = card.getAttribute('data-name');
                    card.style.display = name.includes(term) ? 'flex' : 'none';
                });
            });
        }
    </script>
</body>
</html>