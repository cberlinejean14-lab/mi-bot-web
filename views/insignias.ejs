<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>PREM - Catálogo de Insignias</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .page-container { max-width: 900px; margin: 120px auto; padding: 20px; }
        .badge-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 25px; margin-top: 30px; }
        .badge-card { 
            background: rgba(25, 20, 45, 0.7); 
            border: 1px solid rgba(192, 132, 252, 0.3); 
            border-radius: 20px; 
            padding: 25px; 
            text-align: center;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }
        .badge-card:hover {
            border-color: var(--accent-color);
            box-shadow: 0 0 20px rgba(192, 132, 252, 0.4);
            transform: translateY(-5px);
        }
        .badge-icon { font-size: 3rem; color: var(--accent-color); margin-bottom: 15px; }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="page-container">
        <h1>Catálogo de Insignias</h1>
        <p>Gana insignias participando en la comunidad y demostrando tu lealtad a PREM.</p>
        <div class="badge-grid">
            <% const badges = [
                { id: 'Fundador', icon: 'fa-rocket', desc: 'Presente desde la fase beta' },
                { id: 'Arquitecto de Bot', icon: 'fa-robot', desc: 'Configuró su propio bot' },
                { id: 'Impulsor Estrella', icon: 'fa-star', desc: 'Votó por el bot' },
                { id: 'Comandante', icon: 'fa-terminal', desc: 'Usó muchos comandos' },
                { id: 'Guardián', icon: 'fa-shield-alt', desc: 'Ayudó en el soporte' },
                { id: 'Leyenda', icon: 'fa-crown', desc: 'Nivel 100 alcanzado' },
                { id: 'Activo', icon: 'fa-bolt', desc: '500+ mensajes enviados' },
                { id: 'Premium', icon: 'fa-gem', desc: 'Suscriptor activo' }
            ]; %>
            <% badges.forEach(b => { %>
                <div class="badge-card">
                    <div class="badge-icon"><i class="fa-solid <%= b.icon %>"></i></div>
                    <h3><%= b.id %></h3>
                    <p><%= b.desc %></p>
                </div>
            <% }); %>
        </div>
    </div>
    <%- include('partials/footer') %>
</body>
</html>
