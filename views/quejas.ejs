<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>PREM - Quejas</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <main style="max-width: 800px; margin: 120px auto 60px auto; padding: 0 20px; position: relative; z-index: 1;">
        <div style="text-align: center; margin-bottom: 50px;">
            <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--text-main); margin-bottom: 15px;">Reportar Queja</h1>
            <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto;">¿Has tenido algún problema con el bot? Envíanos un reporte detallado para ayudarnos a mejorar.</p>
        </div>

        <div class="suggestion-card">
            <form id="complaintForm" onsubmit="return handleComplaintSubmit(event)">
                <!-- Selector de Nivel de Severidad -->
                <div class="form-group">
                    <label>Nivel de Severidad</label>
                    <div class="severity-selector">
                        <div class="severity-pill low" data-severity="low" onclick="selectSeverity(this)">Baja</div>
                        <div class="severity-pill medium" data-severity="medium" onclick="selectSeverity(this)">Media</div>
                        <div class="severity-pill high" data-severity="high" onclick="selectSeverity(this)">Alta</div>
                        <div class="severity-pill critical" data-severity="critical" onclick="selectSeverity(this)">Crítica</div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Tu ID de Discord</label>
                    <input type="text" placeholder="Tu ID de usuario (ej: 123456789012345678)" required>
                </div>

                <div class="form-group">
                    <label>Tipo de Problema</label>
                    <select required>
                        <option value="">Selecciona el tipo de problema</option>
                        <option value="bug">Error o Bug</option>
                        <option value="performance">Problema de Rendimiento</option>
                        <option value="feature">Funcionalidad Incorrecta</option>
                        <option value="abuse">Uso Indebido</option>
                        <option value="other">Otro</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Descripción Detallada</label>
                    <textarea rows="6" placeholder="Describe el problema con el mayor detalle posible. Incluye pasos para reproducirlo, capturas de pantalla o fragmentos de código si es necesario..." required></textarea>
                </div>

                <div class="form-group">
                    <label>Servidor Afectado (ID)</label>
                    <input type="text" placeholder="ID del servidor donde ocurrió el problema">
                </div>

                <button type="submit" class="submit-btn" id="complaintSubmitBtn" style="background: linear-gradient(135deg, #ef4444, #dc2626); box-shadow: 0 4px 20px rgba(239, 68, 68, 0.3);">
                    <span id="complaintSubmitText"><i class="fa-solid fa-paper-plane"></i> Enviar Reporte</span>
                    <span id="complaintSubmitSpinner" style="display: none;"><span class="spinner"></span> Enviando...</span>
                </button>
            </form>
        </div>

        <div style="margin-top: 30px; padding: 20px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: 12px;">
            <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0; text-align: center;">
                <i class="fa-solid fa-triangle-exclamation" style="color: #ef4444; margin-right: 8px;"></i>
                Los reportes falsos o malintencionados pueden resultar en sanciones.
            </p>
        </div>
    </main>

    <%- include('partials/footer') %>

    <div class="toast-container" id="toastContainer"></div>

    <script>
        // Severity selector
        function selectSeverity(element) {
            document.querySelectorAll('.severity-pill').forEach(pill => {
                pill.classList.remove('active');
            });
            element.classList.add('active');
        }

        // Toast system
        function showToast(type, message) {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            
            const toast = document.createElement('div');
            toast.className = 'toast ' + type;
            
            const icons = {
                success: 'fa-circle-check',
                error: 'fa-circle-xmark',
                info: 'fa-circle-info'
            };
            
            toast.innerHTML = '<i class="fa-solid ' + (icons[type] || icons.info) + '"></i><span>' + message + '</span>';
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.classList.add('hiding');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Handle complaint submit
        function handleComplaintSubmit(event) {
            event.preventDefault();
            
            const submitBtn = document.getElementById('complaintSubmitBtn');
            const submitText = document.getElementById('complaintSubmitText');
            const submitSpinner = document.getElementById('complaintSubmitSpinner');
            
            // Show spinner
            submitBtn.disabled = true;
            submitText.style.display = 'none';
            submitSpinner.style.display = 'inline-flex';
            
            // Simulate sending
            setTimeout(() => {
                // Hide spinner
                submitBtn.disabled = false;
                submitText.style.display = 'inline-flex';
                submitSpinner.style.display = 'none';
                
                // Generate tracking code
                const trackingCode = 'CMP-' + Math.floor(100000 + Math.random() * 900000);
                
                // Show success toast with tracking code
                showToast('success', 'Reporte enviado. Código de seguimiento: ' + trackingCode);
                
                // Reset form
                event.target.reset();
                document.querySelectorAll('.severity-pill').forEach(pill => {
                    pill.classList.remove('active');
                });
            }, 1500);
            
            return false;
        }
    </script>
</body>
</html>