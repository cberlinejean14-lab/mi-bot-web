<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>PREM - Sala de Manager</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .manager-container {
            display: flex;
            margin-top: 80px;
            min-height: calc(100vh - 80px);
        }

        .sidebar {
            width: 300px;
            background: var(--card-bg);
            border-right: 1px solid var(--border-color);
            padding: 20px;
            position: fixed;
            height: calc(100vh - 80px);
            overflow-y: auto;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 15px;
            background: linear-gradient(135deg, rgba(168, 85, 247, 0.2), rgba(192, 132, 252, 0.1));
            border-radius: 12px;
            margin-bottom: 25px;
            border: 1px solid var(--border-color);
        }

        .sidebar-header i {
            font-size: 1.5rem;
            color: var(--accent-color);
        }

        .sidebar-header h2 {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0;
        }

        .sidebar-section {
            margin-bottom: 25px;
        }

        .sidebar-title {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            color: var(--text-main);
            text-decoration: none;
            border-radius: 10px;
            margin-bottom: 5px;
            transition: all 0.2s ease;
            font-weight: 500;
            cursor: pointer;
        }

        .sidebar-item:hover, .sidebar-item.active {
            background: rgba(168, 85, 247, 0.1);
            color: var(--accent-color);
        }

        .sidebar-item i {
            width: 20px;
            text-align: center;
        }

        .main-content {
            flex: 1;
            margin-left: 300px;
            padding: 30px 40px;
        }

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
        }

        .page-header h1 {
            font-size: 2rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0;
        }

        .content-section {
            display: none;
        }

        .content-section.active {
            display: block;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 25px;
            backdrop-filter: blur(15px);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card:hover {
            border-color: var(--accent-color);
            transform: translateY(-4px);
            box-shadow: 0 15px 35px var(--accent-glow);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -100%;
            width: 50%;
            height: 200%;
            background: linear-gradient(
                to right,
                transparent,
                var(--shimmer-color),
                transparent
            );
            transform: rotate(30deg);
            transition: 0.8s ease;
            opacity: 0;
            pointer-events: none;
        }

        .stat-card:hover::before {
            left: 120%;
            opacity: 1;
        }

        .stat-card .icon {
            font-size: 2rem;
            color: var(--accent-color);
            margin-bottom: 15px;
        }

        .stat-card .value {
            font-size: 2.5rem;
            font-weight: 800;
            color: var(--text-main);
            margin-bottom: 5px;
        }

        .stat-card .label {
            color: var(--text-muted);
            font-size: 0.95rem;
            font-weight: 600;
        }

        .config-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 20px;
            backdrop-filter: blur(15px);
        }

        .config-card h3 {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 20px 0;
        }

        .notification-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .form-group label {
            display: block;
            color: var(--text-main);
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            color: var(--text-main);
            font-size: 1rem;
            outline: none;
            transition: border-color 0.3s;
        }

        .form-group input:focus,
        .form-group textarea:focus,
        .form-group select:focus {
            border-color: var(--accent-color);
        }

        .btn-primary {
            background: linear-gradient(135deg, #a855f7, var(--accent-color));
            color: white;
            padding: 12px 24px;
            border-radius: 10px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px var(--accent-glow);
        }

        .btn-danger {
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: white;
            padding: 8px 16px;
            border-radius: 8px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }

        .btn-danger:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);
        }

        .notification-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 20px;
        }

        .notification-item {
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .notification-content {
            flex: 1;
        }

        .notification-title {
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 5px;
        }

        .notification-message {
            color: var(--text-muted);
            font-size: 0.9rem;
        }

        .notification-date {
            color: var(--text-muted);
            font-size: 0.8rem;
            margin-top: 5px;
        }

        .user-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .user-table th,
        .user-table td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid var(--border-color);
        }

        .user-table th {
            background: rgba(255,255,255,0.05);
            color: var(--text-main);
            font-weight: 700;
        }

        .user-table td {
            color: var(--text-muted);
        }

        .user-table tr:hover {
            background: rgba(255,255,255,0.02);
        }

        .status-badge {
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .status-badge.active {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
        }

        .status-badge.suspicious {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
        }

        .status-badge.banned {
            background: rgba(107, 114, 128, 0.2);
            color: #6b7280;
        }

        .search-bar {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            color: var(--text-main);
            font-size: 1rem;
            outline: none;
            margin-bottom: 20px;
        }

        .search-bar:focus {
            border-color: var(--accent-color);
        }

        .admin-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .admin-item {
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .admin-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .admin-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }

        .admin-details h4 {
            color: var(--text-main);
            margin: 0 0 3px 0;
            font-weight: 600;
        }

        .admin-details p {
            color: var(--text-muted);
            font-size: 0.85rem;
            margin: 0;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: var(--text-muted);
        }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 15px;
            opacity: 0.5;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="manager-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <i class="fa-solid fa-crown"></i>
                <h2>Sala de Manager</h2>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-title">Panel Principal</div>
                <a href="#" class="sidebar-item active" onclick="showSection('notifications', this)">
                    <i class="fa-solid fa-bell"></i> Panel de Notificaciones
                </a>
                <a href="#" class="sidebar-item" onclick="showSection('stats', this)">
                    <i class="fa-solid fa-chart-bar"></i> Estadísticas de Usuarios
                </a>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-title">Seguridad</div>
                <a href="#" class="sidebar-item" onclick="showSection('suspicious', this)">
                    <i class="fa-solid fa-user-shield"></i> Usuarios Sospechosos
                </a>
                <a href="#" class="sidebar-item" onclick="showSection('permissions', this)">
                    <i class="fa-solid fa-user-lock"></i> Gestión de Permisos
                </a>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-title">Registros</div>
                <a href="#" class="sidebar-item" onclick="showSection('audit', this)">
                    <i class="fa-solid fa-clipboard-list"></i> Logs de Auditoría
                </a>
                <a href="#" class="sidebar-item" onclick="showSection('history', this)">
                    <i class="fa-solid fa-clock-rotate-left"></i> Historial
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="page-header">
                <h1>Panel de Administración Global</h1>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="width: 10px; height: 10px; background: #22c55e; border-radius: 50%; box-shadow: 0 0 10px #22c55e;"></span>
                    <span style="color: var(--text-muted); font-weight: 600;">Sistema Operativo</span>
                </div>
            </div>

            <!-- Notifications Panel -->
            <div id="notifications" class="content-section active">
                <div class="config-card">
                    <h3>Crear Notificación Global</h3>
                    <form class="notification-form">
                        <div class="form-group">
                            <label>Título de la Notificación</label>
                            <input type="text" placeholder="Ej: Mantenimiento programado">
                        </div>
                        <div class="form-group">
                            <label>Mensaje</label>
                            <textarea rows="4" placeholder="Escribe el mensaje de la notificación..."></textarea>
                        </div>
                        <div class="form-group">
                            <label>Tipo</label>
                            <select>
                                <option value="info">Información</option>
                                <option value="warning">Advertencia</option>
                                <option value="error">Error</option>
                                <option value="success">Éxito</option>
                            </select>
                        </div>
                        <button type="submit" class="btn-primary">
                            <i class="fa-solid fa-paper-plane"></i> Enviar Notificación Global
                        </button>
                    </form>
                </div>

                <div class="config-card">
                    <h3>Notificaciones Activas</h3>
                    <div class="notification-list">
                        <div class="notification-item">
                            <div class="notification-content">
                                <div class="notification-title">🎉 Nueva característica disponible</div>
                                <div class="notification-message">Hemos añadido nuevos comandos de música. ¡Prueba el nuevo sistema!</div>
                                <div class="notification-date">Hace 2 horas</div>
                            </div>
                            <button class="btn-danger">Eliminar</button>
                        </div>
                        <div class="notification-item">
                            <div class="notification-content">
                                <div class="notification-title">⚠️ Mantenimiento programado</div>
                                <div class="notification-message">El bot estará en mantenimiento el domingo a las 3:00 AM UTC.</div>
                                <div class="notification-date">Hace 1 día</div>
                            </div>
                            <button class="btn-danger">Eliminar</button>
                        </div>
                    </div>
                </div>

                <div class="config-card">
                    <h3>Historial de Notificaciones Eliminadas</h3>
                    <div class="notification-list">
                        <div class="notification-item" style="opacity: 0.6;">
                            <div class="notification-content">
                                <div class="notification-title">📢 Actualización del sistema</div>
                                <div class="notification-message">El bot ha sido actualizado a la versión 2.4</div>
                                <div class="notification-date">Eliminada hace 3 días</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- User Statistics -->
            <div id="stats" class="content-section">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="icon"><i class="fa-solid fa-users"></i></div>
                        <div class="value">12,458</div>
                        <div class="label">Total Bot Users</div>
                    </div>
                    <div class="stat-card">
                        <div class="icon"><i class="fa-solid fa-user-check"></i></div>
                        <div class="value">8,234</div>
                        <div class="label">Total Logged Users</div>
                    </div>
                    <div class="stat-card">
                        <div class="icon"><i class="fa-solid fa-server"></i></div>
                        <div class="value">1,567</div>
                        <div class="label">Servidores Activos</div>
                    </div>
                    <div class="stat-card">
                        <div class="icon"><i class="fa-solid fa-terminal"></i></div>
                        <div class="value">2.3M</div>
                        <div class="label">Comandos Ejecutados</div>
                    </div>
                </div>

                <div class="config-card">
                    <h3>Actividad Reciente</h3>
                    <div class="empty-state">
                        <i class="fa-solid fa-chart-line"></i>
                        <p>Gráficos de actividad en tiempo real</p>
                    </div>
                </div>
            </div>

            <!-- Suspicious Users -->
            <div id="suspicious" class="content-section">
                <div class="config-card">
                    <h3>Usuarios Sospechosos</h3>
                    <input type="text" class="search-bar" placeholder="Buscar usuarios por ID o nombre...">
                    
                    <table class="user-table">
                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>ID</th>
                                <th>Razón</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <img src="https://cdn.discordapp.com/embed/avatars/0.png" style="width: 32px; height: 32px; border-radius: 50%;">
                                        <span>User123</span>
                                    </div>
                                </td>
                                <td>123456789</td>
                                <td>Spam masivo</td>
                                <td><span class="status-badge suspicious">Monitoreando</span></td>
                                <td>
                                    <button class="btn-danger">Banear</button>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 10px;">
                                        <img src="https://cdn.discordapp.com/embed/avatars/1.png" style="width: 32px; height: 32px; border-radius: 50%;">
                                        <span>SuspiciousUser</span>
                                    </div>
                                </td>
                                <td>987654321</td>
                                <td>Actividad inusual</td>
                                <td><span class="status-badge suspicious">Investigando</span></td>
                                <td>
                                    <button class="btn-danger">Banear</button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Permissions Management -->
            <div id="permissions" class="content-section">
                <div class="config-card">
                    <h3>Gestión de Permisos</h3>
                    <form class="notification-form">
                        <div class="form-group">
                            <label>ID de Discord del Usuario</label>
                            <input type="text" placeholder="Ingresa el ID de Discord (ej: 123456789012345678)">
                        </div>
                        <div class="form-group">
                            <label>Nivel de Permiso</label>
                            <select>
                                <option value="manager">Manager (Acceso completo)</option>
                                <option value="admin">Administrador (Acceso limitado)</option>
                                <option value="moderator">Moderador (Básico)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn-primary">
                            <i class="fa-solid fa-user-plus"></i> Otorgar Permiso
                        </button>
                    </form>
                </div>

                <div class="config-card">
                    <h3>Administradores Actuales</h3>
                    <div class="admin-list">
                        <div class="admin-item">
                            <div class="admin-info">
                                <img src="https://cdn.discordapp.com/embed/avatars/0.png" class="admin-avatar">
                                <div class="admin-details">
                                    <h4>MainAdmin</h4>
                                    <p>ID: 123456789012345678</p>
                                </div>
                            </div>
                            <div>
                                <span class="status-badge active">Manager</span>
                                <button class="btn-danger" style="margin-left: 10px;">Revocar</button>
                            </div>
                        </div>
                        <div class="admin-item">
                            <div class="admin-info">
                                <img src="https://cdn.discordapp.com/embed/avatars/1.png" class="admin-avatar">
                                <div class="admin-details">
                                    <h4>SupportAdmin</h4>
                                    <p>ID: 987654321098765432</p>
                                </div>
                            </div>
                            <div>
                                <span class="status-badge active">Admin</span>
                                <button class="btn-danger" style="margin-left: 10px;">Revocar</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Audit Logs -->
            <div id="audit" class="content-section">
                <div class="config-card">
                    <h3>Logs de Auditoría</h3>
                    <div class="empty-state">
                        <i class="fa-solid fa-clipboard-list"></i>
                        <p>Registro de cambios administrativos y acciones del sistema</p>
                    </div>
                </div>
            </div>

            <!-- History -->
            <div id="history" class="content-section">
                <div class="config-card">
                    <h3>Historial de Actividad</h3>
                    <div class="empty-state">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                        <p>Historial completo de acciones y eventos del sistema</p>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function showSection(sectionId, element) {
            // Hide all sections
            document.querySelectorAll('.content-section').forEach(section => {
                section.classList.remove('active');
            });
            
            // Show selected section
            document.getElementById(sectionId).classList.add('active');
            
            // Update sidebar active state
            document.querySelectorAll('.sidebar-item').forEach(item => {
                item.classList.remove('active');
            });
            element.classList.add('active');
        }
    </script>
</body>
</html>