<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>PREM - Documentación</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .documentation-container {
            display: flex;
            margin-top: 100px;
            min-height: calc(100vh - 100px);
            gap: 40px;
            padding: 0 40px 40px 40px;
        }

        .doc-sidebar {
            width: 320px;
            position: sticky;
            top: 100px;
            height: fit-content;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 25px;
            backdrop-filter: blur(15px);
        }

        .doc-search {
            position: relative;
            margin-bottom: 25px;
        }

        .doc-search input {
            width: 100%;
            padding: 12px 16px 12px 45px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            color: var(--text-main);
            font-size: 0.95rem;
            outline: none;
            transition: border-color 0.3s;
        }

        .doc-search input:focus {
            border-color: var(--accent-color);
        }

        .doc-search i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
        }

        .doc-sidebar-title {
            font-size: 0.75rem;
            font-weight: 700;
            color: #a78bfa;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 15px;
        }

        .doc-nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            color: var(--text-main);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            border-radius: 10px;
            margin-bottom: 5px;
            transition: all 0.3s ease;
        }

        .doc-nav-link:hover {
            background: rgba(168, 85, 247, 0.1);
            transform: translateX(5px);
            color: var(--accent-color);
        }

        .doc-nav-link i {
            width: 20px;
            text-align: center;
            color: var(--accent-color);
        }

        .doc-content {
            flex: 1;
            max-width: 900px;
        }

        .doc-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 35px;
            margin-bottom: 30px;
            backdrop-filter: blur(15px);
            transition: all 0.3s ease;
        }

        .doc-card:hover {
            border-color: var(--accent-color);
            box-shadow: 0 15px 35px var(--accent-glow);
        }

        .doc-card h2 {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 20px 0;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .doc-card h2 i {
            color: #c084fc;
            font-size: 1.5rem;
        }

        .doc-card h3 {
            font-size: 1.3rem;
            font-weight: 600;
            color: #e879f9;
            margin: 25px 0 15px 0;
        }

        .doc-card p {
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 15px;
        }

        .doc-card ul {
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.7;
            margin: 15px 0;
            padding-left: 25px;
        }

        .doc-card li {
            margin-bottom: 10px;
        }

        .code-snippet-box {
            background: #05070f;
            border: 1px solid rgba(192, 132, 252, 0.3);
            border-radius: 12px;
            padding: 20px;
            margin: 20px 0;
            position: relative;
            font-family: 'Fira Code', 'Consolas', monospace;
        }

        .code-snippet-box code {
            color: #c084fc;
            font-size: 0.95rem;
            line-height: 1.6;
        }

        .copy-button {
            position: absolute;
            top: 15px;
            right: 15px;
            background: rgba(192, 132, 252, 0.2);
            border: 1px solid rgba(192, 132, 252, 0.4);
            color: #c084fc;
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .copy-button:hover {
            background: rgba(192, 132, 252, 0.3);
        }

        .copy-button.copied {
            background: rgba(34, 197, 94, 0.2);
            border-color: rgba(34, 197, 94, 0.4);
            color: #22c55e;
        }

        @media (max-width: 900px) {
            .documentation-container {
                flex-direction: column;
                padding: 0 20px 20px 20px;
            }

            .doc-sidebar {
                width: 100%;
                position: relative;
                top: 0;
            }
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="documentation-container">
        <!-- Sidebar -->
        <aside class="doc-sidebar">
            <div class="doc-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="Buscar documentación..." id="docSearch">
            </div>

            <div class="doc-sidebar-title">Guías Principales</div>
            <a href="#inicio" class="doc-nav-link">
                <i class="fa-solid fa-rocket"></i> Guía de Inicio
            </a>
            <a href="#niveles" class="doc-nav-link">
                <i class="fa-solid fa-chart-line"></i> Sistema de Niveles
            </a>
            <a href="#economia" class="doc-nav-link">
                <i class="fa-solid fa-coins"></i> Economía Virtual
            </a>
            <a href="#moderacion" class="doc-nav-link">
                <i class="fa-solid fa-shield-halved"></i> Moderación
            </a>

            <div class="doc-sidebar-title" style="margin-top: 25px;">Configuración</div>
            <a href="#bienvenidas" class="doc-nav-link">
                <i class="fa-solid fa-door-open"></i> Bienvenidas
            </a>
            <a href="#dashboard" class="doc-nav-link">
                <i class="fa-solid fa-gauge"></i> Panel de Control
            </a>
            <a href="#musica" class="doc-nav-link">
                <i class="fa-solid fa-music"></i> Sistema de Música
            </a>
        </aside>

        <!-- Content -->
        <main class="doc-content">
            <div class="doc-card" id="inicio">
                <h2><i class="fa-solid fa-rocket"></i> Guía de Inicio</h2>
                <p>Aprende cómo agregar el bot a tu servidor y configurar las funciones básicas para comenzar a usar PREM Bot al máximo.</p>
                
                <h3>Paso 1: Agregar el Bot</h3>
                <p>Ve a la página principal y haz clic en el botón "Añadir el bot". Selecciona tu servidor de la lista y otorga los permisos necesarios de administrador.</p>
                
                <h3>Paso 2: Configuración Básica</h3>
                <p>Una vez agregado, accede al panel de control desde el menú desplegable de tu perfil. Configura el prefijo de comandos y el idioma del bot.</p>
                
                <div class="code-snippet-box">
                    <code>/config prefix !</code>
                    <button class="copy-button" onclick="copyCode(this)">
                        <i class="fa-regular fa-copy"></i> Copiar
                    </button>
                </div>
            </div>

            <div class="doc-card" id="niveles">
                <h2><i class="fa-solid fa-chart-line"></i> Sistema de Niveles</h2>
                <p>Configura el sistema de XP, roles automáticos por nivel y recompensas personalizadas para fomentar la actividad en tu servidor.</p>
                
                <h3>Configuración de XP</h3>
                <p>Define cuánta experiencia ganan los usuarios por mensaje y configura el tiempo de espera entre ganancias de XP.</p>
                
                <div class="code-snippet-box">
                    <code>/level config xp-per-message 15</code>
                    <button class="copy-button" onclick="copyCode(this)">
                        <i class="fa-regular fa-copy"></i> Copiar
                    </button>
                </div>
                
                <h3>Roles Automáticos</h3>
                <p>Configura roles que se otorgan automáticamente cuando los usuarios alcanzan ciertos niveles.</p>
            </div>

            <div class="doc-card" id="economia">
                <h2><i class="fa-solid fa-coins"></i> Economía Virtual</h2>
                <p>Configura la economía, tienda y sistemas de recompensas del servidor con monedas virtuales.</p>
                
                <h3>Comandos Básicos</h3>
                <ul>
                    <li><code>/balance</code> - Ver tu saldo actual</li>
                    <li><code>/daily</code> - Reclamar recompensa diaria</li>
                    <li><code>/work</code> - Trabajar para ganar monedas</li>
                    <li><code>/crime</code> - Arriesgarte a cometer crímenes</li>
                </ul>
                
                <div class="code-snippet-box">
                    <code>/daily</code>
                    <button class="copy-button" onclick="copyCode(this)">
                        <i class="fa-regular fa-copy"></i> Copiar
                    </button>
                </div>
            </div>

            <div class="doc-card" id="moderacion">
                <h2><i class="fa-solid fa-shield-halved"></i> Moderación Automática</h2>
                <p>Configura el auto-moderación, filtros de contenido y sistemas de advertencias para mantener tu servidor seguro.</p>
                
                <h3>Filtros Disponibles</h3>
                <ul>
                    <li>Anti-spam</li>
                    <li>Anti-links</li>
                    <li>Anti-menciones masivas</li>
                    <li>Filtro de contenido inapropiado</li>
                </ul>
            </div>

            <div class="doc-card" id="bienvenidas">
                <h2><i class="fa-solid fa-door-open"></i> Bienvenidas y Despedidas</h2>
                <p>Personaliza los mensajes de bienvenida con variables dinámicas y banners personalizados.</p>
                
                <h3>Variables Disponibles</h3>
                <ul>
                    <li><code>{user}</code> - Mención del usuario</li>
                    <li><code>{server}</code> - Nombre del servidor</li>
                    <li><code>{memberCount}</code> - Número de miembros</li>
                    <li><code>{avatar}</code> - URL del avatar</li>
                </ul>
            </div>

            <div class="doc-card" id="dashboard">
                <h2><i class="fa-solid fa-gauge"></i> Panel de Control</h2>
                <p>Aprende a usar el dashboard web para gestionar todas las configuraciones del bot de manera visual e intuitiva.</p>
                
                <h3>Secciones del Dashboard</h3>
                <ul>
                    <li>Configuración General</li>
                    <li>Sistema de Bienvenidas</li>
                    <li>Moderación</li>
                    <li>Niveles y XP</li>
                    <li>Economía</li>
                    <li>Música</li>
                </ul>
            </div>

            <div class="doc-card" id="musica">
                <h2><i class="fa-solid fa-music"></i> Sistema de Música</h2>
                <p>Configura el sistema de reproducción de audio con soporte para múltiples plataformas.</p>
                
                <h3>Comandos de Música</h3>
                <ul>
                    <li><code>/play</code> - Reproducir una canción</li>
                    <li><code>/skip</code> - Saltar a la siguiente</li>
                    <li><code>/queue</code> - Ver la lista de reproducción</li>
                    <li><code>/volume</code> - Ajustar el volumen</li>
                </ul>
                
                <div class="code-snippet-box">
                    <code>/play Never Gonna Give You Up</code>
                    <button class="copy-button" onclick="copyCode(this)">
                        <i class="fa-regular fa-copy"></i> Copiar
                    </button>
                </div>
            </div>
        </main>
    </div>

    <%- include('partials/footer') %>

    <script>
        function copyCode(button) {
            const codeBox = button.parentElement;
            const code = codeBox.querySelector('code').textContent;
            
            navigator.clipboard.writeText(code).then(() => {
                button.innerHTML = '<i class="fa-solid fa-check"></i> ¡Copiado!';
                button.classList.add('copied');
                
                setTimeout(() => {
                    button.innerHTML = '<i class="fa-regular fa-copy"></i> Copiar';
                    button.classList.remove('copied');
                }, 2000);
            });
        }

        // Search functionality
        document.getElementById('docSearch').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const links = document.querySelectorAll('.doc-nav-link');
            
            links.forEach(link => {
                const text = link.textContent.toLowerCase();
                if (text.includes(searchTerm)) {
                    link.style.display = 'flex';
                } else {
                    link.style.display = 'none';
                }
            });
        });
    </script>
</body>
</html>