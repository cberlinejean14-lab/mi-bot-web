<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>PREM - Documentación</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <main style="max-width: 1200px; margin: 120px auto 60px auto; padding: 0 20px;">
        <div style="text-align: center; margin-bottom: 50px;">
            <h1 style="font-size: 2.5rem; font-weight: 800; color: var(--text-main); margin-bottom: 15px;">Documentación y Guías</h1>
            <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 0 auto;">Aprende a configurar y usar PREM Bot al máximo con nuestras guías completas.</p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px;">
            <!-- Guía de Inicio -->
            <div class="doc-card" style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 20px; padding: 30px; backdrop-filter: blur(15px); transition: all 0.3s ease; position: relative; overflow: hidden;">
                <div style="width: 50px; height: 50px; border-radius: 14px; background: var(--badge-bg); border: 1px solid var(--badge-border); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                    <i class="fa-solid fa-rocket" style="font-size: 1.5rem; color: var(--accent-color);"></i>
                </div>
                <h2 style="font-size: 1.3rem; font-weight: 700; color: var(--text-main); margin-bottom: 12px;">Guía de Inicio</h2>
                <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin-bottom: 20px;">Aprende cómo agregar el bot a tu servidor y configurar las funciones básicas.</p>
                <a href="#" style="color: var(--accent-color); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    Leer guía <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <!-- Configuración de Niveles -->
            <div class="doc-card" style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 20px; padding: 30px; backdrop-filter: blur(15px); transition: all 0.3s ease; position: relative; overflow: hidden;">
                <div style="width: 50px; height: 50px; border-radius: 14px; background: var(--badge-bg); border: 1px solid var(--badge-border); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                    <i class="fa-solid fa-chart-line" style="font-size: 1.5rem; color: var(--accent-color);"></i>
                </div>
                <h2 style="font-size: 1.3rem; font-weight: 700; color: var(--text-main); margin-bottom: 12px;">Sistema de Niveles</h2>
                <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin-bottom: 20px;">Configura el sistema de XP, roles automáticos y recompensas por nivel.</p>
                <a href="#" style="color: var(--accent-color); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    Leer guía <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <!-- Configuración de Economía -->
            <div class="doc-card" style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 20px; padding: 30px; backdrop-filter: blur(15px); transition: all 0.3s ease; position: relative; overflow: hidden;">
                <div style="width: 50px; height: 50px; border-radius: 14px; background: var(--badge-bg); border: 1px solid var(--badge-border); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                    <i class="fa-solid fa-coins" style="font-size: 1.5rem; color: var(--accent-color);"></i>
                </div>
                <h2 style="font-size: 1.3rem; font-weight: 700; color: var(--text-main); margin-bottom: 12px;">Economía Virtual</h2>
                <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin-bottom: 20px;">Configura la economía, tienda y sistemas de recompensas del servidor.</p>
                <a href="#" style="color: var(--accent-color); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    Leer guía <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <!-- Configuración de Moderación -->
            <div class="doc-card" style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 20px; padding: 30px; backdrop-filter: blur(15px); transition: all 0.3s ease; position: relative; overflow: hidden;">
                <div style="width: 50px; height: 50px; border-radius: 14px; background: var(--badge-bg); border: 1px solid var(--badge-border); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                    <i class="fa-solid fa-shield-halved" style="font-size: 1.5rem; color: var(--accent-color);"></i>
                </div>
                <h2 style="font-size: 1.3rem; font-weight: 700; color: var(--text-main); margin-bottom: 12px;">Moderación Automática</h2>
                <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin-bottom: 20px;">Configura el auto-moderación, filtros de contenido y sistemas de advertencias.</p>
                <a href="#" style="color: var(--accent-color); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    Leer guía <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <!-- Sistema de Bienvenidas -->
            <div class="doc-card" style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 20px; padding: 30px; backdrop-filter: blur(15px); transition: all 0.3s ease; position: relative; overflow: hidden;">
                <div style="width: 50px; height: 50px; border-radius: 14px; background: var(--badge-bg); border: 1px solid var(--badge-border); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                    <i class="fa-solid fa-door-open" style="font-size: 1.5rem; color: var(--accent-color);"></i>
                </div>
                <h2 style="font-size: 1.3rem; font-weight: 700; color: var(--text-main); margin-bottom: 12px;">Bienvenidas y Despedidas</h2>
                <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin-bottom: 20px;">Personaliza los mensajes de bienvenida con variables y banners personalizados.</p>
                <a href="#" style="color: var(--accent-color); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    Leer guía <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>

            <!-- Panel de Control -->
            <div class="doc-card" style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 20px; padding: 30px; backdrop-filter: blur(15px); transition: all 0.3s ease; position: relative; overflow: hidden;">
                <div style="width: 50px; height: 50px; border-radius: 14px; background: var(--badge-bg); border: 1px solid var(--badge-border); display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
                    <i class="fa-solid fa-gauge" style="font-size: 1.5rem; color: var(--accent-color);"></i>
                </div>
                <h2 style="font-size: 1.3rem; font-weight: 700; color: var(--text-main); margin-bottom: 12px;">Panel de Control</h2>
                <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.5; margin-bottom: 20px;">Aprende a usar el dashboard web para gestionar todas las configuraciones.</p>
                <a href="#" style="color: var(--accent-color); text-decoration: none; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                    Leer guía <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/main.js"></script>
</body>
</html>