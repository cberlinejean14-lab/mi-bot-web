<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>PREM - Perfil de Usuario</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        /* Estilo Gaming Profesional */
        body {
            background: #050505;
            color: #fff;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            background-image: url('https://wallpaperaccess.com/full/1569947.jpg');
            background-size: cover;
            background-attachment: fixed;
            background-position: center;
        }

        body::before {
            content: '';
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.75);
            z-index: -1;
        }

        .profile-container {
            max-width: 800px;
            margin: 100px auto;
            background: rgba(15, 15, 20, 0.85);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 40px;
            text-align: center;
        }

        .profile-avatar-wrapper {
            width: 140px;
            height: 140px;
            margin: -100px auto 20px auto;
            border-radius: 20px;
            border: 4px solid #1a1a2e;
            box-shadow: 0 0 20px rgba(0,0,0,0.5);
            overflow: hidden;
        }
        .profile-avatar-wrapper img { width: 100%; height: 100%; object-fit: cover; }

        .user-name { font-size: 2.5rem; font-weight: 900; margin: 10px 0; }
        
        .badges-wrapper { display: flex; justify-content: center; gap: 8px; margin-bottom: 30px; }
        .badge { 
            padding: 5px 12px; border-radius: 6px; font-size: 0.75rem; 
            text-transform: uppercase; letter-spacing: 1px; font-weight: 700;
        }

        .xp-section { width: 80%; margin: 30px auto; text-align: center; }
        .progress-bar { height: 10px; background: #1a1a2e; border-radius: 5px; overflow: hidden; }
        .progress-fill { height: 100%; background: linear-gradient(90deg, #6366f1, #a855f7); }

        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin: 40px 0;
        }
        .stat-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 20px;
            border-radius: 16px;
        }
        .stat-card .value { font-size: 1.4rem; font-weight: 800; color: #fff; }
        .stat-card .label { font-size: 0.7rem; color: #888; text-transform: uppercase; margin-top: 5px; }

        .profile-actions { display: flex; justify-content: center; gap: 15px; margin-top: 30px; }
        .action-btn {
            padding: 12px 24px; border-radius: 8px; text-decoration: none; 
            font-weight: 600; font-size: 0.9rem; transition: 0.3s;
        }
        .btn-logout { background: transparent; border: 1px solid #ef4444; color: #ef4444; }
        .btn-logout:hover { background: #ef4444; color: white; }


        .badges { display: flex; justify-content: center; gap: 10px; margin-bottom: 20px; }
        .badge { padding: 4px 12px; border-radius: 15px; font-size: 0.8rem; font-weight: 600; color: white; }
        .badge-grandpa { background: #ef4444; }
        .badge-subscriber { background: #8b5cf6; }

        .xp-section { margin: 30px 0; }
        .xp-bar-container { display: flex; align-items: center; gap: 15px; width: 100%; margin-top: 10px; }
        .progress-bar { 
            position: relative; 
            flex-grow: 1; 
            height: 24px; 
            background: #1e1b4b; 
            border: 1px solid var(--accent-color);
            border-radius: 12px; 
            overflow: hidden; 
        }
        .progress-fill { 
            height: 100%; 
            background: linear-gradient(90deg, #a855f7, #ec4899); 
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: bold;
        }
        .level-badge { 
            width: 45px;
            height: 45px;
            background: var(--accent-color);
            color: #0b0416;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50% 50% 50% 0;
            font-weight: 800;
            transform: rotate(-45deg);
        }
        .level-badge span { transform: rotate(45deg); }

        .user-header-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin: 10px 0;
        }
        .user-badge-small {
            color: var(--accent-color);
            font-size: 1.2rem;
        }
        .profile-actions {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
        }
        .action-btn {
            padding: 8px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: white;
            text-decoration: none;
            font-size: 0.9rem;
            transition: 0.3s;
        }
        .action-btn:hover { background: var(--accent-color); color: #0b0416; }
        .my-badges-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            margin-top: 15px;
        }
        .badge-pill {
            padding: 5px 12px;
            background: rgba(168, 85, 247, 0.2);
            border: 1px solid #a855f7;
            border-radius: 15px;
            font-size: 0.8rem;
        }



        .info-item .value {
            font-size: 1rem;
            color: var(--text-main);
            font-weight: 600;
            word-break: break-all;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .status-badge.active {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
        }

        .status-badge.pending {
            background: rgba(251, 191, 36, 0.2);
            color: #fbbf24;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="profile-page">
        <div class="profile-container">
            <div class="profile-avatar-wrapper">
                <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=256` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="Avatar">
            </div>
            
            <h2 class="user-name"><%= user.global_name || user.username %></h2>
            
            <div class="badges-wrapper">
                <% if (userData && userData.badges) { userData.badges.forEach(badge => { %>
                    <span class="badge" style="background: var(--accent-color);"><%= badge %></span>
                <% }); } %>
            </div>

            <div class="xp-section">
                <p style="margin-bottom: 8px; font-weight: 600;">Nivel <%= userData ? userData.level || 1 : 1 %></p>
                <div class="progress-bar">
                    <% const xpCurrent = userData ? (userData.xp % 1000) : 0; const progress = Math.min(100, Math.max(0, (xpCurrent / 1000) * 100)); %>
                    <div class="progress-fill" style="width: <%= progress %>%;"></div>
                </div>
            </div>

            <div class="stats-row">
                <div class="stat-card">
                    <div class="value"><%= userData ? userData.money || 0 : 0 %></div>
                    <div class="label">Dinero</div>
                </div>
                <div class="stat-card">
                    <div class="value"><%= userData ? userData.messages || 0 : 0 %></div>
                    <div class="label">Mensajes</div>
                </div>
                <div class="stat-card">
                    <div class="value"><%= userData ? userData.antiguedad || 'N/A' : 'N/A' %></div>
                    <div class="label">Antigüedad</div>
                </div>
                <div class="stat-card">
                    <div class="value">#<%= userData ? userData.rank || 0 : 0 %></div>
                    <div class="label">Ranking</div>
                </div>
            </div>

            <div class="profile-actions">
                <a href="#" class="action-btn" style="background: var(--accent-color); color: white;">Editar</a>
                <a href="/logout" class="action-btn btn-logout">Cerrar Sesión</a>
            </div>
        </div>
    </div>


    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>