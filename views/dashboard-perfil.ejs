<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>PREM - Perfil de Usuario</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .profile-page {
            max-width: 1000px;
            margin: 120px auto 60px auto;
            padding: 0 20px;
            position: relative;
            z-index: 1;
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 30px;
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 1px solid var(--border-color);
            flex-wrap: wrap;
        }

        .profile-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--accent-color);
            box-shadow: 0 0 25px var(--accent-glow);
        }

        .profile-info h2 {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0 0 5px 0;
        }

        .profile-info p {
            color: var(--text-muted);
            font-size: 1rem;
            margin: 0;
        }

        .profile-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .profile-stat {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            backdrop-filter: blur(15px);
            transition: all 0.3s ease;
        }

        .profile-stat:hover {
            border-color: var(--accent-color);
            box-shadow: 0 5px 20px var(--accent-glow);
        }

        .profile-stat .value {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--accent-color);
            margin-bottom: 5px;
        }

        .profile-stat .label {
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 600;
        }

        /* Nuevo diseño de perfil */
        .profile-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 30px;
            backdrop-filter: blur(15px);
            margin-bottom: 30px;
        }

        .profile-banner-layout {
            display: flex;
            align-items: center;
            gap: 30px;
            flex-wrap: wrap;
        }

        .profile-left {
            display: flex;
            align-items: center;
            gap: 20px;
            flex: 1;
            min-width: 300px;
        }

        .profile-right {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 20px;
            flex: 2;
            width: 100%;
        }

        .stat-box {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            padding: 15px;
            border-radius: 12px;
            text-align: center;
        }
        
        .stat-box .value { font-size: 1.2rem; font-weight: 700; color: var(--accent-color); }
        .stat-box .label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; }

        .badges-section {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 30px;
            margin-top: 20px;
        }

        .badges-container {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-top: 15px;
        }

        .badge-item {
            padding: 8px 16px;
            background: rgba(192, 132, 252, 0.1);
            border: 1px solid var(--accent-color);
            border-radius: 20px;
            color: var(--accent-color);
            font-size: 0.85rem;
            font-weight: 600;
        }


        .info-item .value {
            font-size: 1rem;
            color: var(--text-main);
            font-weight: 600;
            word-break: break-all;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .status-badge.active {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
        }

        .status-badge.pending {
            background: rgba(251, 191, 36, 0.2);
            color: #fbbf24;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="profile-page">
        <div class="profile-card">
            <div class="profile-banner-layout">
                <div class="profile-left">
                    <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=256` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="Avatar" class="profile-avatar">
                    <div class="profile-info">
                        <h2><%= user.global_name || user.username %></h2>
                        <p>@<%= user.username %></p>
                        <span class="status-badge active" style="margin-top: 10px; display: inline-block;"><i class="fa-solid fa-circle-check"></i> Cuenta Activa</span>
                    </div>
                </div>
                <div class="profile-right">
                    <div class="stat-box">
                        <div class="value"><%= userData ? userData.money || 0 : 0 %></div>
                        <div class="label">Monedas</div>
                    </div>
                    <div class="stat-box">
                        <div class="value"><%= userData ? userData.level || 1 : 1 %></div>
                        <div class="label">Nivel</div>
                    </div>
                    <div class="stat-box">
                        <div class="value"><%= userData ? userData.songs || 0 : 0 %></div>
                        <div class="label">Canciones</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="badges-section">
            <h3 style="margin-top: 0;">Insignias</h3>
            <div class="badges-container">
                <div class="badge-item"><i class="fa-solid fa-star"></i> Usuario PREM</div>
                <div class="badge-item"><i class="fa-solid fa-bolt"></i> Activo</div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>