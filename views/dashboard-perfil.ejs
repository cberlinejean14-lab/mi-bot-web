<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>PREM - Perfil de Usuario</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .profile-page {
            max-width: 1000px;
            margin: 120px auto 60px auto;
            padding: 0 20px;
            position: relative;
            z-index: 1;
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 30px;
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 1px solid var(--border-color);
            flex-wrap: wrap;
        }

        .profile-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--accent-color);
            box-shadow: 0 0 25px var(--accent-glow);
        }

        .profile-info h2 {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0 0 5px 0;
        }

        .profile-info p {
            color: var(--text-muted);
            font-size: 1rem;
            margin: 0;
        }

        .profile-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .profile-stat {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            backdrop-filter: blur(15px);
            transition: all 0.3s ease;
        }

        .profile-stat:hover {
            border-color: var(--accent-color);
            box-shadow: 0 5px 20px var(--accent-glow);
        }

        .profile-stat .value {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--accent-color);
            margin-bottom: 5px;
        }

        .profile-stat .label {
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 600;
        }

        /* Diseño de perfil estilo gamer */
        .profile-container {
            max-width: 900px;
            margin: 120px auto;
            background: #0b0416;
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            border: 1px solid rgba(192, 132, 252, 0.2);
        }

        .profile-bg-banner {
            height: 200px;
            background: linear-gradient(to right, #1e1b4b, #4c1d95, #1e1b4b);
            position: relative;
        }

        .profile-avatar-wrapper {
            position: absolute;
            top: 100px;
            left: 50%;
            transform: translateX(-50%);
            width: 150px;
            height: 150px;
            border: 6px solid #fbbf24; /* Marco dorado */
            border-radius: 50%;
            padding: 4px;
            background: #0b0416;
        }

        .profile-avatar-wrapper img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .profile-content {
            padding: 80px 40px 40px;
            text-align: center;
        }

        .user-name { font-size: 2rem; font-weight: 800; color: white; margin: 10px 0; }

        .badges { display: flex; justify-content: center; gap: 10px; margin-bottom: 20px; }
        .badge { padding: 4px 12px; border-radius: 15px; font-size: 0.8rem; font-weight: 600; color: white; }
        .badge-grandpa { background: #ef4444; }
        .badge-subscriber { background: #8b5cf6; }

        .xp-section { margin: 30px 0; }
        .xp-bar-container { display: flex; align-items: center; gap: 15px; width: 100%; }
        .progress-bar { flex-grow: 1; height: 12px; background: #333; border-radius: 6px; overflow: hidden; }
        .progress-fill { height: 100%; background: #ec4899; width: 34%; }
        .level-badge { background: #ec4899; padding: 5px 10px; border-radius: 5px; font-weight: bold; }

        .stats-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 20px; margin-top: 40px; }
        .stat-item { display: flex; flex-direction: column; align-items: center; gap: 10px; }
        .stat-item i { font-size: 1.5rem; color: #fbbf24; }



        .info-item .value {
            font-size: 1rem;
            color: var(--text-main);
            font-weight: 600;
            word-break: break-all;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .status-badge.active {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
        }

        .status-badge.pending {
            background: rgba(251, 191, 36, 0.2);
            color: #fbbf24;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="profile-page">
    <div class="profile-container">
        <div class="profile-bg-banner"></div>
        <div class="profile-avatar-wrapper">
            <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=256` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="Avatar">
        </div>
        
        <div class="profile-content">
            <h2 class="user-name"><%= user.global_name || user.username %></h2>
            
            <div class="xp-section">
                <!-- XP Real conectado del backend -->
                <p style="color: #9ca3af; font-size: 0.9rem; margin-bottom: 8px;">
                    <%= userData ? userData.xp || 0 : 0 %> XP to Level <%= userData ? (userData.level || 1) + 1 : 2 %>
            <div class="badges" style="margin: 20px 0; display: flex; justify-content: center; gap: 10px;">
                <% if (userData && userData.badges) { userData.badges.forEach(badge => { %>
                    <span class="badge" style="background: #a855f7; padding: 5px 12px; border-radius: 15px; font-size: 0.8rem;"><%= badge %></span>
                <% }); } %>
            </div>

                </p>
                <div class="xp-bar-container">
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: <%= userData ? Math.min((userData.xp % 1000) / 10, 100) : 0 %>%;"></div>
                    </div>
                    <span class="level-badge"><%= userData ? userData.level || 1 : 1 %></span>
                </div>
            </div>
            
            <div style="margin-top: 30px;">
                <a href="/insignias" style="color: var(--accent-color); text-decoration: none; font-weight: 600;">Ver catálogo de insignias disponibles</a>
            </div>
        </div>
    </div>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>