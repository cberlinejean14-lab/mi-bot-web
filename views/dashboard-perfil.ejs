<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>PREM - Perfil de Usuario</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .profile-page {
            max-width: 1000px;
            margin: 120px auto 60px auto;
            padding: 0 20px;
            position: relative;
            z-index: 1;
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 30px;
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 1px solid var(--border-color);
            flex-wrap: wrap;
        }

        .profile-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--accent-color);
            box-shadow: 0 0 25px var(--accent-glow);
        }

        .profile-info h2 {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0 0 5px 0;
        }

        .profile-info p {
            color: var(--text-muted);
            font-size: 1rem;
            margin: 0;
        }

        .profile-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .profile-stat {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            backdrop-filter: blur(15px);
            transition: all 0.3s ease;
        }

        .profile-stat:hover {
            border-color: var(--accent-color);
            box-shadow: 0 5px 20px var(--accent-glow);
        }

        .profile-stat .value {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--accent-color);
            margin-bottom: 5px;
        }

        .profile-stat .label {
            color: var(--text-muted);
            font-size: 0.9rem;
            font-weight: 600;
        }

        .profile-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 24px;
            padding: 40px;
            backdrop-filter: blur(15px);
            box-sizing: border-box;
            max-width: 100%;
        }

        .profile-card h3 {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 20px 0;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 15px;
        }

        .info-item {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 15px;
        }

        .info-item .label {
            font-size: 0.8rem;
            color: var(--text-muted);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 5px;
        }

        .info-item .value {
            font-size: 1rem;
            color: var(--text-main);
            font-weight: 600;
            word-break: break-all;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .status-badge.active {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
        }

        .status-badge.pending {
            background: rgba(251, 191, 36, 0.2);
            color: #fbbf24;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="profile-page">
        <div class="profile-card">
            <div class="profile-header">
                <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=256` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="Avatar" class="profile-avatar">
                <div class="profile-info">
                    <h2><%= user.global_name || user.username %></h2>
                    <p>@<%= user.username %></p>
                    <div style="margin-top: 10px;">
                        <span class="status-badge active"><i class="fa-solid fa-circle-check"></i> Cuenta Activa</span>
                    </div>
                </div>
            </div>

            <h3>Información de la Cuenta</h3>
            <div class="info-grid">
                <div class="info-item">
                    <div class="label">ID de Discord</div>
                    <div class="value"><%= user.id %></div>
                </div>
                <div class="info-item">
                    <div class="label">Nombre de Usuario</div>
                    <div class="value"><%= user.username %></div>
                </div>
                <div class="info-item">
                    <div class="label">Nombre Global</div>
                    <div class="value"><%= user.global_name || user.username %></div>
                </div>
                <div class="info-item">
                    <div class="label">Fecha de Registro</div>
                    <div class="value"><%= new Date().toLocaleDateString() %></div>
                </div>
                <div class="info-item">
                    <div class="label">Estado de Cuenta</div>
                    <div class="value"><span class="status-badge active">Activa</span></div>
                </div>
                <div class="info-item">
                    <div class="label">Servidores Vinculados</div>
                    <div class="value"><%= user.guilds ? user.guilds.length : 0 %></div>
                </div>
            </div>

            <h3 style="margin-top: 30px;">Estadísticas del Usuario</h3>
            <div class="profile-stats">
                <div class="profile-stat">
                    <div class="value"><%= userData ? userData.money || 0 : 0 %></div>
                    <div class="label">Monedas</div>
                </div>
                <div class="profile-stat">
                    <div class="value"><%= userData ? userData.level || 1 : 1 %></div>
                    <div class="label">Nivel</div>
                </div>
                <div class="profile-stat">
                    <div class="value"><%= userData ? userData.songs || 0 : 0 %></div>
                    <div class="label">Canciones Reproducidas</div>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>