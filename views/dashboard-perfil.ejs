<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>PREM - Perfil de Usuario</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .profile-page {
            max-width: 900px;
            margin: 120px auto 60px auto;
            padding: 0 20px;
        }

        .profile-avatar-wrapper {
            position: relative;
            margin: 0 auto;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: 4px solid var(--accent-color);
            padding: 4px;
        }
        .profile-avatar-wrapper img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
        
        .profile-content { padding: 40px 20px; text-align: center; }
        
        .user-header-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin: 20px 0;
        }
        .user-name { font-size: 2.5rem; font-weight: 800; color: white; margin: 0; }
        .user-badge-small { color: var(--accent-color); font-size: 1.5rem; cursor: help; }

        .stats-row {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin: 40px 0;
        }
        .stat-card {
            background: rgba(255, 255, 255, 0.03);
            padding: 20px;
            border-radius: 16px;
        }
        .stat-card .value { font-size: 1.5rem; font-weight: 700; color: white; }
        .stat-card .label { font-size: 0.8rem; color: #9ca3af; text-transform: uppercase; }
        
        .my-badges-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 15px; }
        .badge-pill {
            padding: 5px 12px;
            background: rgba(168, 85, 247, 0.2);
            border: 1px solid #a855f7;
            border-radius: 15px;
            font-size: 0.8rem;
            color: white;
            text-decoration: none;
        }
    </style>

        .profile-container {
            max-width: 600px;
            margin: 120px auto;
            position: relative;
            background: transparent !important;
            padding: 0;
        }

        .profile-bg-banner { display: none; }

        .profile-avatar-wrapper {
            margin: 0 auto 20px auto;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 4px solid var(--accent-color);
            padding: 4px;
        }
        .profile-avatar-wrapper img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
        
        .profile-content { padding: 20px; text-align: center; background: transparent; }
        
        .user-header-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
        }
        .user-name { font-size: 2rem; font-weight: 800; color: white; margin: 0; }
        .user-badge-small { color: var(--accent-color); font-size: 1.2rem; }

        .stats-row {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            margin: 20px 0;
        }
        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .stat-card .value { font-size: 1.2rem; font-weight: 700; color: white; }
        .stat-card .label { font-size: 0.75rem; color: #9ca3af; text-transform: uppercase; }
        
        .xp-section { margin: 20px 0; text-align: left; }
        .progress-bar {
            position: relative; 
            height: 12px; 
            background: rgba(255,255,255,0.1); 
            border-radius: 6px; 
            overflow: hidden;
        }
        .progress-fill {
            height: 100%; 
            background: linear-gradient(90deg, #a855f7, #ec4899); 
            transition: width 0.5s ease;
        }

        .badges { display: flex; justify-content: center; gap: 10px; margin-bottom: 20px; }
        .badge { padding: 4px 12px; border-radius: 15px; font-size: 0.8rem; font-weight: 600; color: white; }
        .badge-grandpa { background: #ef4444; }
        .badge-subscriber { background: #8b5cf6; }

        .xp-section { margin: 30px 0; }
        .xp-bar-container { display: flex; align-items: center; gap: 15px; width: 100%; margin-top: 10px; }
        .progress-bar { 
            position: relative; 
            flex-grow: 1; 
            height: 24px; 
            background: #1e1b4b; 
            border: 1px solid var(--accent-color);
            border-radius: 12px; 
            overflow: hidden; 
        }
        .progress-fill { 
            height: 100%; 
            background: linear-gradient(90deg, #a855f7, #ec4899); 
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: bold;
        }
        .level-badge { 
            width: 45px;
            height: 45px;
            background: var(--accent-color);
            color: #0b0416;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50% 50% 50% 0;
            font-weight: 800;
            transform: rotate(-45deg);
        }
        .level-badge span { transform: rotate(45deg); }

        .user-header-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin: 10px 0;
        }
        .user-badge-small {
            color: var(--accent-color);
            font-size: 1.2rem;
        }
        .profile-actions {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 20px;
        }
        .action-btn {
            padding: 8px 16px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: white;
            text-decoration: none;
            font-size: 0.9rem;
            transition: 0.3s;
        }
        .action-btn:hover { background: var(--accent-color); color: #0b0416; }
        .my-badges-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            margin-top: 15px;
        }
        .badge-pill {
            padding: 5px 12px;
            background: rgba(168, 85, 247, 0.2);
            border: 1px solid #a855f7;
            border-radius: 15px;
            font-size: 0.8rem;
        }



        .info-item .value {
            font-size: 1rem;
            color: var(--text-main);
            font-weight: 600;
            word-break: break-all;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .status-badge.active {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
        }

        .status-badge.pending {
            background: rgba(251, 191, 36, 0.2);
            color: #fbbf24;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="profile-page">
        <div class="profile-container">
            <div class="profile-bg-banner"></div>
            <div class="profile-avatar-wrapper">
                <img src="<%= user.avatar ? `https://cdn.discordapp.com/avatars/${user.id}/${user.avatar}.png?size=256` : 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="Avatar">
            </div>
            
            <div class="profile-content">
                <div class="user-header-row">
                    <h2 class="user-name" style="margin: 0;"><%= user.global_name || user.username %></h2>
                    <% if (userData && userData.badges) { %>
                        <% userData.badges.forEach(badge => { %>
                            <span class="user-badge-small" title="<%= badge %>"><i class="fa-solid fa-certificate"></i></span>
                        <% }); %>
                    <% } %>
                </div>
                
                <div class="xp-section">
                    <p style="color: #9ca3af; font-size: 0.9rem; margin-bottom: 8px;">
                        XP: <%= userData ? userData.xp || 0 : 0 %> / 1000
                    </p>
                    <div class="progress-bar">
                        <% const xpCurrent = userData ? (userData.xp % 1000) : 0; const progress = Math.min(100, Math.max(0, (xpCurrent / 1000) * 100)); %>
                        <div class="progress-fill" style="width: <%= progress %>%;"></div>
                    </div>
                </div>
                <div class="stats-row">
                    <div class="stat-card">
                        <div class="value"><%= userData ? userData.money || 0 : 0 %></div>
                        <div class="label">Dinero</div>
                    </div>
                    <div class="stat-card">
                        <div class="value"><%= userData ? userData.messages || 0 : 0 %></div>
                        <div class="label">Mensajes</div>
                    </div>
                    <div class="stat-card">
                        <div class="value"><%= userData ? userData.antiguedad || 'N/A' : 'N/A' %></div>
                        <div class="label">Antigüedad</div>
                    </div>
                    <div class="stat-card">
                        <div class="value">#<%= userData ? userData.rank || 0 : 0 %></div>
                        <div class="label">Ranking</div>
                    </div>
                </div>


                <div class="my-badges-grid">
                    <% if (userData && userData.badges) { userData.badges.forEach(badge => { %>
                        <span class="badge-pill"><%= badge %></span>
                    <% }); } %>
                    <a href="/insignias" class="badge-pill" style="border-style: dashed;">+ Catálogo</a>
                </div>

                <div class="profile-actions">
                    <a href="#" class="action-btn">Editar Perfil</a>
                    <a href="#" class="action-btn">Configuración</a>
                    <a href="/logout" class="action-btn">Cerrar Sesión</a>
                </div>
            </div>
        </div>
    </div>


    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
</body>
</html>