<!DOCTYPE html>
<html lang="<%= typeof currentLang !== 'undefined' ? currentLang : 'es' %>" data-theme="dark">
<head>
    <%- include('partials/head') %>
    <title>PREM - Panel de Control</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .dashboard-container {
            display: flex;
            margin-top: 80px;
            min-height: calc(100vh - 80px);
        }

        .sidebar {
            width: 280px;
            background: var(--card-bg);
            border-right: 1px solid var(--border-color);
            padding: 20px;
            position: fixed;
            height: calc(100vh - 80px);
            overflow-y: auto;
        }

        .sidebar-section {
            margin-bottom: 30px;
        }

        .sidebar-title {
            font-size: 0.85rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 15px;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            color: var(--text-main);
            text-decoration: none;
            border-radius: 10px;
            margin-bottom: 5px;
            transition: all 0.2s ease;
            font-weight: 500;
            cursor: pointer;
        }

        .sidebar-item:hover, .sidebar-item.active {
            background: rgba(168, 85, 247, 0.1);
            color: var(--accent-color);
        }

        .sidebar-item i {
            width: 20px;
            text-align: center;
        }

        .main-content {
            flex: 1;
            margin-left: 280px;
            padding: 30px 40px;
        }

        .server-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
        }

        .server-icon {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            object-fit: cover;
            border: 3px solid var(--accent-color);
            box-shadow: 0 0 20px var(--accent-glow);
        }

        .server-info h1 {
            font-size: 2rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0 0 5px 0;
        }

        .server-info p {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin: 0;
        }

        .content-section {
            display: none;
        }

        .content-section.active {
            display: block;
        }

        .config-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            padding: 25px;
            margin-bottom: 20px;
            backdrop-filter: blur(15px);
        }

        .config-card h3 {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 20px 0;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            color: var(--text-main);
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 0.95rem;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            color: var(--text-main);
            font-size: 1rem;
            outline: none;
            transition: border-color 0.3s;
            box-sizing: border-box;
            max-width: 100%;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: var(--accent-color);
        }

        .toggle-switch {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 15px;
            background: rgba(255,255,255,0.05);
            border-radius: 10px;
            margin-bottom: 10px;
        }

        .toggle-switch label {
            flex: 1;
            color: var(--text-main);
            font-weight: 600;
        }

        .toggle-input {
            width: 50px;
            height: 26px;
            background: rgba(255,255,255,0.1);
            border-radius: 13px;
            position: relative;
            cursor: pointer;
            transition: background 0.3s;
        }

        .toggle-input.active {
            background: var(--accent-color);
        }

        .toggle-input::after {
            content: '';
            position: absolute;
            width: 22px;
            height: 22px;
            background: white;
            border-radius: 50%;
            top: 2px;
            left: 2px;
            transition: transform 0.3s;
        }

        .toggle-input.active::after {
            transform: translateX(24px);
        }

        .btn-save {
            background: linear-gradient(135deg, #a855f7, var(--accent-color));
            color: white;
            padding: 12px 24px;
            border-radius: 10px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px var(--accent-glow);
        }
    </style>
</head>
<body>
    <!-- Luces Ambientales Difusas (Orbs) -->
    <div class="ambient-orb ambient-orb-1"></div>
    <div class="ambient-orb ambient-orb-2"></div>
    <div class="ambient-orb ambient-orb-3"></div>

    <%- include('partials/navbar') %>

    <div class="dashboard-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-section">
                <div class="sidebar-title">General</div>
                <a href="#" class="sidebar-item active" onclick="showSection('general', this)">
                    <i class="fa-solid fa-gear"></i> Configuración General
                </a>
                <a href="#" class="sidebar-item" onclick="showSection('welcomer', this)">
                    <i class="fa-solid fa-door-open"></i> Sistema de Bienvenidas
                </a>
                <a href="#" class="sidebar-item" onclick="showSection('moderation', this)">
                    <i class="fa-solid fa-shield-halved"></i> Moderación
                </a>
                <a href="#" class="sidebar-item" onclick="showSection('levels', this)">
                    <i class="fa-solid fa-chart-line"></i> Niveles y XP
                </a>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-title">Economía</div>
                <a href="#" class="sidebar-item" onclick="showSection('economy', this)">
                    <i class="fa-solid fa-coins"></i> Economía Virtual
                </a>
                <a href="#" class="sidebar-item" onclick="showSection('shop', this)">
                    <i class="fa-solid fa-store"></i> Tienda
                </a>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-title">Entretenimiento</div>
                <a href="#" class="sidebar-item" onclick="showSection('music', this)">
                    <i class="fa-solid fa-music"></i> Música
                </a>
                <a href="#" class="sidebar-item" onclick="showSection('fun', this)">
                    <i class="fa-solid fa-gamepad"></i> Diversión
                </a>
            </div>

            <div class="sidebar-section">
                <div class="sidebar-title">Registros</div>
                <a href="#" class="sidebar-item" onclick="showSection('logs', this)">
                    <i class="fa-solid fa-file-lines"></i> Logs del Servidor
                </a>
                <a href="#" class="sidebar-item" onclick="showSection('audit', this)">
                    <i class="fa-solid fa-clipboard-list"></i> Auditoría
                </a>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <!-- Server Header -->
            <div class="server-header">
                <% if (guild.icon) { %>
                    <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="Server Icon" class="server-icon">
                <% } else { %>
                    <div class="server-icon" style="display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 2rem; color: var(--accent-color);">
                        <%= guild.name.charAt(0) %>
                    </div>
                <% } %>
                <div class="server-info">
                    <h1><%= guild.name %></h1>
                    <p>ID: <%= guild.id %> | <%= guild.owner ? 'Propietario' : 'Administrador' %></p>
                </div>
            </div>

            <!-- General Configuration -->
            <div id="general" class="content-section active">
                <div class="config-card">
                    <h3>Configuración General</h3>
                    <div class="form-group">
                        <label>Prefix de Comandos</label>
                        <input type="text" value="!" placeholder="Prefix personalizado">
                    </div>
                    <div class="form-group">
                        <label>Idioma del Bot</label>
                        <select>
                            <option value="es">Español</option>
                            <option value="en">English</option>
                            <option value="pt">Português</option>
                            <option value="fr">Français</option>
                        </select>
                    </div>
                    <div class="toggle-switch">
                        <label>Mensajes de estado</label>
                        <div class="toggle-input active" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <div class="toggle-switch">
                        <label>Respuestas automáticas</label>
                        <div class="toggle-input" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <button class="btn-save">Guardar Cambios</button>
                </div>
            </div>

            <!-- Welcomer System -->
            <div id="welcomer" class="content-section">
                <div class="config-card">
                    <h3>Sistema de Bienvenidas</h3>
                    <div class="toggle-switch">
                        <label>Activar bienvenida</label>
                        <div class="toggle-input active" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <div class="form-group">
                        <label>Canal de bienvenida</label>
                        <select>
                            <option value="">Seleccionar canal</option>
                            <option value="general">#general</option>
                            <option value="welcome">#bienvenidas</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Mensaje de bienvenida</label>
                        <textarea rows="4" placeholder="Usa variables como {user}, {server}, {memberCount}">¡Bienvenido {user} a {server}! Ahora somos {memberCount} miembros.</textarea>
                    </div>
                    <div class="toggle-switch">
                        <label>Activar despedida</label>
                        <div class="toggle-input" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <div class="form-group">
                        <label>Canal de despedida</label>
                        <select>
                            <option value="">Seleccionar canal</option>
                            <option value="general">#general</option>
                            <option value="logs">#logs</option>
                        </select>
                    </div>
                    <button class="btn-save">Guardar Cambios</button>
                </div>
            </div>

            <!-- Moderation -->
            <div id="moderation" class="content-section">
                <div class="config-card">
                    <h3>Moderación Automática</h3>
                    <div class="toggle-switch">
                        <label>Anti-spam</label>
                        <div class="toggle-input active" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <div class="toggle-switch">
                        <label>Anti-links</label>
                        <div class="toggle-input" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <div class="toggle-switch">
                        <label>Anti-menciones masivas</label>
                        <div class="toggle-input active" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <div class="form-group">
                        <label>Canal de logs de moderación</label>
                        <select>
                            <option value="">Seleccionar canal</option>
                            <option value="mod-logs">#mod-logs</option>
                        </select>
                    </div>
                    <button class="btn-save">Guardar Cambios</button>
                </div>
            </div>

            <!-- Levels -->
            <div id="levels" class="content-section">
                <div class="config-card">
                    <h3>Sistema de Niveles</h3>
                    <div class="toggle-switch">
                        <label>Activar sistema de XP</label>
                        <div class="toggle-input active" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <div class="form-group">
                        <label>XP por mensaje</label>
                        <input type="number" value="15" min="1" max="100">
                    </div>
                    <div class="form-group">
                        <label>Cooldown de XP (segundos)</label>
                        <input type="number" value="60" min="10" max="300">
                    </div>
                    <div class="form-group">
                        <label>Canal de anuncios de nivel</label>
                        <select>
                            <option value="">Seleccionar canal</option>
                            <option value="level-ups">#level-ups</option>
                        </select>
                    </div>
                    <button class="btn-save">Guardar Cambios</button>
                </div>
            </div>

            <!-- Economy -->
            <div id="economy" class="content-section">
                <div class="config-card">
                    <h3>Economía Virtual</h3>
                    <div class="toggle-switch">
                        <label>Activar economía</label>
                        <div class="toggle-input active" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <div class="form-group">
                        <label>Moneda inicial</label>
                        <input type="number" value="1000" min="0">
                    </div>
                    <div class="form-group">
                        <label>Recompensa diaria</label>
                        <input type="number" value="500" min="0">
                    </div>
                    <button class="btn-save">Guardar Cambios</button>
                </div>
            </div>

            <!-- Shop -->
            <div id="shop" class="content-section">
                <div class="config-card">
                    <h3>Tienda del Servidor</h3>
                    <div class="toggle-switch">
                        <label>Activar tienda</label>
                        <div class="toggle-input active" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <p style="color: var(--text-muted); margin-bottom: 20px;">Configura los items disponibles en la tienda del servidor.</p>
                    <button class="btn-save">Guardar Cambios</button>
                </div>
            </div>

            <!-- Music -->
            <div id="music" class="content-section">
                <div class="config-card">
                    <h3>Sistema de Música</h3>
                    <div class="toggle-switch">
                        <label>Activar música</label>
                        <div class="toggle-input active" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <div class="form-group">
                        <label>Volumen predeterminado</label>
                        <input type="range" min="0" max="100" value="75">
                    </div>
                    <div class="toggle-switch">
                        <label>Canciones en cola ilimitadas</label>
                        <div class="toggle-input" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <button class="btn-save">Guardar Cambios</button>
                </div>
            </div>

            <!-- Fun -->
            <div id="fun" class="content-section">
                <div class="config-card">
                    <h3>Comandos de Diversión</h3>
                    <div class="toggle-switch">
                        <label>Activar comandos fun</label>
                        <div class="toggle-input active" onclick="this.classList.toggle('active')"></div>
                    </div>
                    <button class="btn-save">Guardar Cambios</button>
                </div>
            </div>

            <!-- Logs -->
            <div id="logs" class="content-section">
                <div class="config-card">
                    <h3>Logs del Servidor</h3>
                    <p style="color: var(--text-muted);">Visualiza los registros de actividad del servidor.</p>
                    <div style="padding: 20px; background: rgba(255,255,255,0.05); border-radius: 10px; margin-top: 20px;">
                        <p style="color: var(--text-muted); text-align: center;">No hay logs recientes</p>
                    </div>
                </div>
            </div>

            <!-- Audit -->
            <div id="audit" class="content-section">
                <div class="config-card">
                    <h3>Registro de Auditoría</h3>
                    <p style="color: var(--text-muted);">Historial de cambios de configuración y acciones administrativas.</p>
                    <div style="padding: 20px; background: rgba(255,255,255,0.05); border-radius: 10px; margin-top: 20px;">
                        <p style="color: var(--text-muted); text-align: center;">No hay registros de auditoría recientes</p>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        function showSection(sectionId, element) {
            // Hide all sections
            document.querySelectorAll('.content-section').forEach(section => {
                section.classList.remove('active');
            });
            
            // Show selected section
            document.getElementById(sectionId).classList.add('active');
            
            // Update sidebar active state
            document.querySelectorAll('.sidebar-item').forEach(item => {
                item.classList.remove('active');
            });
            element.classList.add('active');
        }
    </script>
</body>
</html>